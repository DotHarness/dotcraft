# Local install and harness output. The built bundle is committed on purpose: a plugin
# whose desktop/dist/index.mjs is missing is skipped during discovery, so the samples
# would not be installable from a clone.
*/desktop/node_modules/
*/desktop/preview/index.css
*/desktop/preview/preview.js
*/desktop/preview/assets/

!*/desktop/dist/
!*/desktop/dist/index.mjs
!*/desktop/dist/index.css
!*/desktop/dist/assets/
!*/desktop/dist/assets/*
