{
  "name": "@dotcraft/channel-weixin",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "description": "DotCraft channel adapter for WeChat (iLink)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "dotcraft-channel-weixin": "./dist/cli.js"
  },
  "files": [
    "dist",
    "manifest.json"
  ],
  "scripts": {
    "start": "node dist/cli.js --workspace .",
    "generate:manifest": "node ../../scripts/generate-manifest.mjs .",
    "build": "node ../../scripts/clean-dist.mjs . && tsc -p tsconfig.json && npm run generate:manifest",
    "bundle": "node ../../scripts/bundle-channel.mjs .",
    "dev": "npm run build && node dist/cli.js --workspace .",
    "test": "npm run build && node --test dist/config.test.js dist/auth.test.js dist/conformance.test.js dist/weixin-adapter.test.js dist/weixin-api.test.js dist/weixin-media.test.js dist/weixin-text-delivery.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dotcraft/channel": "*",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.7.0"
  }
}
