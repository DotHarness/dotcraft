{
  "name": "@dotcraft/channel-feishu",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "description": "DotCraft channel adapter for Feishu/Lark",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "dotcraft-channel-feishu": "./dist/cli.js"
  },
  "files": [
    "dist",
    "vendor",
    "official-cli/lark-cli.lock.json",
    "manifest.json",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "start": "node dist/cli.js --workspace .",
    "generate:manifest": "node ../../scripts/generate-manifest.mjs .",
    "build": "node ../../scripts/clean-dist.mjs . && tsc -p tsconfig.json && npm run generate:manifest",
    "bundle": "node ../../scripts/bundle-channel.mjs .",
    "stage:official-cli": "node scripts/stage-official-cli.mjs",
    "refresh:official-cli-catalog": "node scripts/stage-official-cli.mjs --refresh-catalog true",
    "verify:official-cli": "node scripts/verify-official-cli.mjs",
    "dev": "npm run build && node dist/cli.js --workspace .",
    "test": "npm run build && node --test dist/feishu-client.test.js dist/feishu-cli-runner.test.js dist/feishu-transcript.test.js dist/transcript-streamer.test.js dist/event-handler.test.js dist/card-action-dedup.test.js dist/card-builder.test.js dist/config.test.js dist/conformance.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dotcraft/channel": "*",
    "@larksuiteoapi/node-sdk": "^1.67.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
