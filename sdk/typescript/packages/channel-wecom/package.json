{
  "name": "@dotcraft/channel-wecom",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "DotCraft channel adapter for WeCom",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "dotcraft-channel-wecom": "./dist/cli.js"
  },
  "files": [
    "dist",
    "manifest.json",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "start": "node dist/cli.js --workspace .",
    "generate:manifest": "node ../../scripts/generate-manifest.mjs .",
    "build": "node ../../scripts/clean-dist.mjs . && tsc -p tsconfig.json && npm run generate:manifest",
    "bundle": "node ../../scripts/bundle-channel.mjs .",
    "dev": "npm run build && node dist/cli.js --workspace .",
    "test": "npm run build && node --test dist/config.test.js dist/conformance.test.js dist/crypto.test.js dist/message-splitter.test.js dist/pusher.test.js dist/wecom-adapter.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dotcraft/channel": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
