{
  "references": [
    { "path": "./packages/channel-feishu" },
    { "path": "./packages/channel-weixin" },
    { "path": "./packages/channel-telegram" },
    { "path": "./packages/channel-qq" },
    { "path": "./packages/channel-wecom" }
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
