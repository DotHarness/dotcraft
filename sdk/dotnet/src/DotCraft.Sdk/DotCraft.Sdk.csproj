<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\..\src\DotCraft.Package.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Lightweight .NET SDK for DotCraft Hub and AppServer protocol clients.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dotcraft;appserver;json-rpc;sdk;ai</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\DotCraft.Protocol\DotCraft.Protocol.csproj" />
    <ProjectReference Include="..\..\..\..\src\DotCraft.Protocol.Generators\DotCraft.Protocol.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
    <AdditionalFiles Include="..\..\..\..\src\DotCraft.Protocol\Artifacts\AppServer\appserver.manifest.json" />
  </ItemGroup>

</Project>
