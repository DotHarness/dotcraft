<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>DotCraft.Sdk</PackageId>
    <Version>0.1.0</Version>
    <Authors>DotHarness</Authors>
    <Description>Lightweight .NET SDK for DotCraft Hub and AppServer protocol clients.</Description>
    <PackageProjectUrl>https://github.com/DotHarness/dotcraft-dotnet</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/DotHarness/dotcraft-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotcraft;appserver;json-rpc;sdk;ai</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
