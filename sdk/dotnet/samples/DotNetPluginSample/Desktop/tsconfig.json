{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true
  },
  "include": [
    "Core/src/**/*.ts",
    "Core/src/**/*.tsx",
    "Consumer/src/**/*.ts",
    "Consumer/src/**/*.tsx",
    "shared/**/*.ts"
  ]
}
