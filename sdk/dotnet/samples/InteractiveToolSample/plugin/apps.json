{
  "apps": [
    {
      "appId": "com.dotcraft.sample-ui",
      "displayName": "Sample Interactive UI",
      "developerName": "DotCraft",
      "description": "Renders a sample MCP-Apps Interactive Tool UI card.",
      "category": "Developer",
      "icon": "./dotcraft-sample-ui.svg",
      "originChannel": "dotcraftsample",
      "nativeApplication": {
        "displayName": "Sample Interactive UI",
        "protocol": "dotcraftsample"
      },
      "connection": {
        "handoffModes": [
          {
            "mode": "customProtocol",
            "uriTemplate": "dotcraftsample://dotcraft/{operation}?app={appId}&request={requestId}&token={requestToken}&endpoint={endpoint}"
          }
        ]
      },
      "security": {
        "privacyPolicyUrl": "https://example.com/privacy",
        "supportUrl": "https://example.com/support"
      }
    }
  ]
}
