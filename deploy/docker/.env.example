# DotCraft server
# Leave empty to let the container generate and persist one in ./workspace/.craft/appserver.token.
APPSERVER_TOKEN=
APPSERVER_PORT=9100
DASHBOARD_PORT=8080

# Model provider. DOTCRAFT_API_KEY stays in the container environment; the
# generated ~/.craft/config.json stores a $DOTCRAFT_API_KEY reference.
DOTCRAFT_PROVIDER=openai
DOTCRAFT_PROVIDER_DISPLAY_NAME=OpenAI
DOTCRAFT_PROVIDER_PROTOCOL=openai-chat-completions
DOTCRAFT_PROVIDER_ENDPOINT=https://api.openai.com/v1
DOTCRAFT_API_KEY=
DOTCRAFT_MODEL=gpt-4o-mini

# Comma-separated channels to enable: telegram,feishu,qq,wecom,weixin
# Use "all" for telegram,feishu,qq,wecom. Weixin still requires QR login.
ENABLED_CHANNELS=

# Sandbox is optional and off by default. To enable it:
#   SANDBOX_ENABLED=true docker compose --profile sandbox up -d
SANDBOX_ENABLED=false
SANDBOX_IMAGE=ubuntu:latest

# Telegram
TELEGRAM_BOT_TOKEN=

# Feishu / Lark
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# QQ / OneBot reverse WebSocket. Configure NapCat to connect to
# ws://<server>:${QQ_PORT}/ with the access token below.
QQ_HOST=0.0.0.0
QQ_PORT=6700
QQ_ACCESS_TOKEN=

# WeCom callback. Configure WeCom to call:
# http://<server>:${WECOM_PORT}${WECOM_ROBOT_PATH}
WECOM_HOST=0.0.0.0
WECOM_PORT=9000
WECOM_ROBOT_PATH=/dotcraft
WECOM_ROBOT_TOKEN=
WECOM_ROBOT_AES_KEY=

# Weixin uses interactive QR login. After startup, watch:
# ./workspace/.craft/tmp/channel-weixin-standard/qr.png
WEIXIN_API_BASE_URL=https://ilinkai.weixin.qq.com
