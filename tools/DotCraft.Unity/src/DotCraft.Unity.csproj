<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DotCraft.Unity</AssemblyName>
    <DebugType>none</DebugType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Payload/**/*.cs" />
    <EmbeddedResource Include="Payload/*.cs" LogicalName="DotCraft.Unity.Payload.%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <ProjectReference Include="../../../src/DotCraft.Core/DotCraft.Core.csproj" Private="false" />
    <ProjectReference Include="../../../src/DotCraft.Generators/DotCraft.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="../../../sdk/dotnet/samples/DotNetPluginSample/HostAssemblies.targets" />
</Project>
