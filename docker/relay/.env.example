# DotCraft relay for phones outside the computer's network.
DOTCRAFT_VERSION=latest

# Token computers use to register with this relay. Enter the same value in
# Desktop under Settings > Connections > Phones > Access from anywhere.
# Generate one with: openssl rand -hex 32
RELAY_TOKEN=

# Public DNS name Caddy obtains a certificate for, such as relay.example.com.
# Ports 80 and 443 must reach this server.
RELAY_PUBLIC_HOST=

# Host interface for the relay's own port. Keep it private when Caddy, or
# another reverse proxy on this server, serves public HTTPS.
RELAY_PUBLISH_HOST=127.0.0.1
RELAY_PORT=47620
