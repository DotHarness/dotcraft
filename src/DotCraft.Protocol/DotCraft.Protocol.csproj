<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\DotCraft.Package.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotCraft.Protocol</RootNamespace>
    <Description>Pure executable contracts for the DotCraft AppServer protocol.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotCraft.Protocol.Generators\DotCraft.Protocol.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

</Project>
