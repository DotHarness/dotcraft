{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/UserInputQuestion.schema.json",
  "title": "UserInputQuestion",
  "type": "object",
  "properties": {
    "header": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "isOther": {
      "type": "boolean"
    },
    "isSecret": {
      "type": "boolean"
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "./UserInputOption.schema.json"
      }
    },
    "question": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "header",
    "id",
    "isOther",
    "isSecret",
    "options",
    "question"
  ]
}
