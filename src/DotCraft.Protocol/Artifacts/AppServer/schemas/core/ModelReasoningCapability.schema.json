{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ModelReasoningCapability.schema.json",
  "title": "ModelReasoningCapability",
  "type": "object",
  "properties": {
    "defaultEffort": {
      "type": "string"
    },
    "defaultOutput": {
      "type": "string"
    },
    "supportedEfforts": {
      "type": "array",
      "items": {
        "$ref": "./ModelReasoningEffortOption.schema.json"
      }
    },
    "supportedOutputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supportsDisable": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
