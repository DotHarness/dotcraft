{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/HookMetadata.schema.json",
  "title": "HookMetadata",
  "type": "object",
  "properties": {
    "asyncRewake": {
      "type": "boolean"
    },
    "command": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "condition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "currentHash": {
      "type": "string"
    },
    "displayOrder": {
      "type": "integer"
    },
    "enabled": {
      "type": "boolean"
    },
    "eventName": {
      "type": "string"
    },
    "executionMode": {
      "type": "string"
    },
    "handlerType": {
      "type": "string"
    },
    "isManaged": {
      "type": "boolean"
    },
    "key": {
      "type": "string"
    },
    "matcher": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "once": {
      "type": "boolean"
    },
    "pluginId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "rewakeMessage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "rewakeSummary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "shell": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string"
    },
    "sourcePath": {
      "type": "string"
    },
    "statusMessage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "timeoutSec": {
      "type": "integer"
    },
    "trustStatus": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
