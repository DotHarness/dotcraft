{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ModelCatalogItem.schema.json",
  "title": "ModelCatalogItem",
  "type": "object",
  "properties": {
    "contextWindow": {
      "type": "integer"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "defaultProtocol": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "inputModalities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "isDefault": {
      "type": "boolean"
    },
    "maxOutputTokens": {
      "type": "integer"
    },
    "ownedBy": {
      "type": "string"
    },
    "pricing": {
      "$ref": "./ModelPricingInfo.schema.json"
    },
    "reasoning": {
      "anyOf": [
        {
          "$ref": "./ModelReasoningCapability.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "speed": {
      "anyOf": [
        {
          "$ref": "./ModelSpeedCapability.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "supportedProtocols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
