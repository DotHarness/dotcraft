{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/PluginAppInfo.schema.json",
  "title": "PluginAppInfo",
  "type": "object",
  "properties": {
    "appId": {
      "type": "string"
    },
    "category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "developerName": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "icon": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "nativeApplication": {
      "anyOf": [
        {
          "$ref": "./PluginAppNativeApplication.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "releasePage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true
}
