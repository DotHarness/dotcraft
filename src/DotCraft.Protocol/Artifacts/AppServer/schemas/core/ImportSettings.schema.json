{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ImportSettings.schema.json",
  "title": "ImportSettings",
  "type": "object",
  "properties": {
    "lastSyncAt": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "syncEnabled": {
      "type": "boolean"
    },
    "syncIntervalMinutes": {
      "type": "integer"
    },
    "workspaceOptOut": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "required": [
    "sources",
    "syncEnabled",
    "syncIntervalMinutes",
    "workspaceOptOut"
  ]
}
