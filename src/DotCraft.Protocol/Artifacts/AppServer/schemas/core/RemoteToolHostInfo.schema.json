{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/RemoteToolHostInfo.schema.json",
  "title": "RemoteToolHostInfo",
  "type": "object",
  "properties": {
    "displayName": {
      "type": "string"
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "hostId": {
      "type": "string"
    },
    "online": {
      "type": "boolean"
    },
    "workspaces": {
      "type": "array",
      "items": {
        "$ref": "./RemoteToolHostWorkspaceInfo.schema.json"
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "displayName",
    "hostId",
    "online",
    "workspaces"
  ]
}
