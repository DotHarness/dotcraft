{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ThreadReadState.schema.json",
  "title": "ThreadReadState",
  "type": "object",
  "properties": {
    "firstUnread": {
      "anyOf": [
        {
          "$ref": "./ThreadFirstUnread.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "firstUnread",
    "revision"
  ]
}
