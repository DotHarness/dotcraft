{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/DreamsRunState.schema.json",
  "title": "DreamsRunState",
  "type": "object",
  "properties": {
    "autoApplied": {
      "type": "boolean"
    },
    "candidateThreadCount": {
      "type": "integer"
    },
    "dreamWritten": {
      "type": "boolean"
    },
    "endedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorType": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceReadCount": {
      "type": "integer"
    },
    "evidenceSearchCount": {
      "type": "integer"
    },
    "evidenceThreadIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "historyWritten": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "inputManifestPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "outputStoreId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "processedThreadCount": {
      "type": "integer"
    },
    "reviewStatus": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string"
    },
    "threadId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "topicFilesDeleted": {
      "type": "integer"
    },
    "topicFilesWritten": {
      "type": "integer"
    },
    "trigger": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "turnId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "turnIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "./TokenUsageInfo.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "writtenPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
