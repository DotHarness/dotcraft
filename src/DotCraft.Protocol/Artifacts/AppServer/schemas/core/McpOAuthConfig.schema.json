{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/McpOAuthConfig.schema.json",
  "title": "McpOAuthConfig",
  "type": "object",
