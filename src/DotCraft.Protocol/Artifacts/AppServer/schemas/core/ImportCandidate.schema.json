{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ImportCandidate.schema.json",
  "title": "ImportCandidate",
  "type": "object",
  "properties": {
    "category": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "fallbackText": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "sourceId": {
      "type": "string"
    },
    "sourcePath": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "targetPath": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "turnCount": {
      "type": "integer"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true,
  "required": [
    "category",
    "cwd",
    "fallbackText",
    "fingerprint",
    "reason",
    "scope",
    "source",
    "sourceId",
    "sourcePath",
    "state",
    "targetPath",
    "title",
    "turnCount",
    "updatedAt"
  ]
}
