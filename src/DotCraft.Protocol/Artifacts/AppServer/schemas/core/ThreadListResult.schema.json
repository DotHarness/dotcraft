{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ThreadListResult.schema.json",
  "title": "ThreadListResult",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "./ThreadSummary.schema.json"
      }
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "totalMatched": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "data"
  ]
}
