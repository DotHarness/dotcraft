{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/DynamicToolCallResult.schema.json",
  "title": "DynamicToolCallResult",
  "type": "object",
  "properties": {
    "contentItems": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "./DynamicToolContentItem.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorMessage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "structuredContent": {},
    "success": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "required": [
    "success"
  ]
}
