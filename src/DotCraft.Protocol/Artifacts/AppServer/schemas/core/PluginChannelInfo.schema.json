{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/PluginChannelInfo.schema.json",
  "title": "PluginChannelInfo",
  "type": "object",
  "properties": {
    "capabilitySummary": {
      "$ref": "./PluginChannelCapabilitySummary.schema.json"
    },
    "channelContractVersion": {
      "type": "string"
    },
    "channelName": {
      "type": "string"
    },
    "compatibilityError": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "configDescriptors": {
      "type": "array",
      "items": {}
    },
    "configGroups": {
      "type": "array",
      "items": {}
    },
    "displayName": {
      "type": "string"
    },
    "interface": {},
    "localizedDisplayName": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "minHostVersion": {
      "type": "string"
    },
    "moduleId": {
      "type": "string"
    },
    "packageName": {
      "type": "string"
    },
    "requiresInteractiveSetup": {
      "type": "boolean"
    },
    "supportedChannelProtocolVersions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supportedTransports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variant": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "capabilitySummary",
    "channelContractVersion",
    "channelName",
    "configDescriptors",
    "configGroups",
    "displayName",
    "minHostVersion",
    "moduleId",
    "packageName",
    "requiresInteractiveSetup",
    "supportedChannelProtocolVersions",
    "supportedTransports",
    "variant"
  ]
}
