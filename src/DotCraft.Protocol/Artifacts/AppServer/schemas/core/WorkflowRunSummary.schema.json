{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/WorkflowRunSummary.schema.json",
  "title": "WorkflowRunSummary",
  "type": "object",
  "properties": {
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "controls": {
      "$ref": "./WorkflowRunControls.schema.json"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "resumedFromRunId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    },
    "totals": {
      "$ref": "./WorkflowRunTotals.schema.json"
    }
  },
  "additionalProperties": true,
  "required": [
    "controls",
    "createdAt",
    "description",
    "name",
    "runId",
    "status",
    "threadId",
    "totals"
  ]
}
