{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ThreadResumeCurrentState.schema.json",
  "title": "ThreadResumeCurrentState",
  "type": "object",
  "properties": {
    "activeItems": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "./SessionItem.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "diff": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "itemCount": {
      "type": "integer"
    },
    "pendingRequests": {
      "type": "array",
      "items": {
        "$ref": "./ThreadPendingRequestState.schema.json"
      }
    },
    "planTurnId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "toolArguments": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "toolProgress": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "./ThreadToolProgressState.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "turnId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "turnStatus": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "itemCount",
    "pendingRequests"
  ]
}
