{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/McpServerRuntimeRegisterParams.schema.json",
  "title": "McpServerRuntimeRegisterParams",
  "type": "object",
  "properties": {
    "headers": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "requiredPlugins": {
      "anyOf": [
        {
          "type": "array",
