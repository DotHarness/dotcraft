{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ThreadWorktreeInfo.schema.json",
  "title": "ThreadWorktreeInfo",
  "type": "object",
  "properties": {
    "baseHead": {
      "type": "string"
    },
    "baseRef": {
      "type": "string"
    },
    "branchName": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "dirtyHandoff": {
      "anyOf": [
        {
          "$ref": "./ThreadWorktreeDirtyHandoffInfo.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "head": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "ownerId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "ownerKind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "path": {
      "type": "string"
    },
    "sourceThreadId": {
      "type": "string"
    },
    "sourceWorkspacePath": {
      "type": "string"
    },
    "workspacePath": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
