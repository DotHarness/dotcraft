{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/UsageThreadResult.schema.json",
  "title": "UsageThreadResult",
  "type": "object",
  "properties": {
    "cacheHitRate": {
      "type": "number"
    },
    "cachedInputTokens": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "./UsageThreadGroup.schema.json"
      }
    },
    "inputTokens": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "outputTokens": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "threadId": {
      "type": "string"
    },
    "totalTokens": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "turns": {
      "type": "integer"
    }
  },
  "additionalProperties": true
}
