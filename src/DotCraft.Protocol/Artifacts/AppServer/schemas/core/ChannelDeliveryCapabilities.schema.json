{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ChannelDeliveryCapabilities.schema.json",
  "title": "ChannelDeliveryCapabilities",
  "type": "object",
  "properties": {
    "history": {
      "anyOf": [
        {
          "$ref": "./ChannelHistoryCapability.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "media": {
      "anyOf": [
        {
          "$ref": "./ChannelMediaCapabilitySet.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "targets": {
      "$ref": "./ChannelTargetCapability.schema.json"
    },
    "text": {
      "$ref": "./ChannelTextCapability.schema.json"
    }
  },
  "additionalProperties": true,
  "required": [
    "targets",
    "text"
  ]
}
