{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/RpcError.schema.json",
  "title": "RpcError",
  "type": "object",
  "properties": {
    "code": {
      "type": "integer"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "./RpcErrorData.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "code",
    "message"
  ]
}
