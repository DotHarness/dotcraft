{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ProviderBackendInfo.schema.json",
  "title": "ProviderBackendInfo",
  "type": "object",
  "properties": {
    "authenticationMethods": {
      "type": "array",
      "items": {
        "$ref": "./ProviderAuthenticationMethodInfo.schema.json"
      }
    },
    "defaultProtocol": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "protocols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "authenticationMethods",
    "defaultProtocol",
    "displayName",
    "id",
    "protocols"
  ]
}
