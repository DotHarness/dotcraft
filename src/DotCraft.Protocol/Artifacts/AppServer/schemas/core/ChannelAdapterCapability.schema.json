{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ChannelAdapterCapability.schema.json",
  "title": "ChannelAdapterCapability",
  "type": "object",
  "properties": {
    "channelName": {
      "type": "string"
    },
    "channelTools": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "./ChannelToolDescriptor.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "deliveryCapabilities": {
      "$ref": "./ChannelDeliveryCapabilities.schema.json"
    },
    "displayName": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "channelName",
    "deliveryCapabilities",
    "displayName"
  ]
}
