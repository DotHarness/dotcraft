{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/UsageThreadRow.schema.json",
  "title": "UsageThreadRow",
  "type": "object",
  "properties": {
    "archived": {
      "type": "boolean"
    },
    "cacheHitRate": {
      "type": "number"
    },
    "cachedInputTokens": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "inputTokens": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "lastActiveAt": {
      "type": "string"
    },
    "originChannel": {
      "type": "string"
    },
    "outputTokens": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "threadId": {
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "totalTokens": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "turns": {
      "type": "integer"
    }
  },
  "additionalProperties": true
}
