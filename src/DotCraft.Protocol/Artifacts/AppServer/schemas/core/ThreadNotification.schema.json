{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ThreadNotification.schema.json",
  "title": "ThreadNotification",
  "type": "object",
  "properties": {
    "resumedBy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "thread": {
      "$ref": "./SessionThread.schema.json"
    }
  },
  "additionalProperties": true,
  "required": [
    "thread"
  ]
}
