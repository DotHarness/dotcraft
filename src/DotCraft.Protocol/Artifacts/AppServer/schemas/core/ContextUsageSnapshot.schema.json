{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ContextUsageSnapshot.schema.json",
  "title": "ContextUsageSnapshot",
  "type": "object",
  "properties": {
    "autoCompactThreshold": {
      "type": "integer"
    },
    "contextWindow": {
      "type": "integer"
    },
    "errorThreshold": {
      "type": "integer"
    },
    "isEstimate": {
      "type": "boolean"
    },
    "percentLeft": {
      "type": "number"
    },
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "tokens": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "warningThreshold": {
      "type": "integer"
    }
  },
  "additionalProperties": true
}
