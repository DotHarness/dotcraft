{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/RemoteToolHostListResult.schema.json",
  "title": "RemoteToolHostListResult",
  "type": "object",
  "properties": {
    "hosts": {
      "type": "array",
      "items": {
        "$ref": "./RemoteToolHostInfo.schema.json"
      }
    },
    "route": {
      "anyOf": [
        {
          "$ref": "./RemoteToolRouteInfo.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "hosts"
  ]
}
