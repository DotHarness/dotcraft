{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ProviderAuthPrompt.schema.json",
  "title": "ProviderAuthPrompt",
  "type": "object",
  "properties": {
    "choices": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "./ProviderAuthChoice.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "kind",
    "message"
  ]
}
