{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ImportSourceDetection.schema.json",
  "title": "ImportSourceDetection",
  "type": "object",
  "properties": {
    "available": {
      "type": "boolean"
    },
    "importableCount": {
      "type": "integer"
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "./ImportSessionCandidate.schema.json"
      }
    },
    "source": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "available",
    "importableCount",
    "sessions",
    "source"
  ]
}
