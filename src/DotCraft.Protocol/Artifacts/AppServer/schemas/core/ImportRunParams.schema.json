{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ImportRunParams.schema.json",
  "title": "ImportRunParams",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "./ImportItemReference.schema.json"
      }
    },
    "offered": {
      "$ref": "./ImportSelection.schema.json"
    },
    "selection": {
      "$ref": "./ImportSelection.schema.json"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "items",
    "selection",
    "sources"
  ]
}
