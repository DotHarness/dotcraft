{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/AgentImportUploadResult.schema.json",
  "title": "AgentImportUploadResult",
  "type": "object",
  "properties": {
    "importId": {
      "type": "string"
    },
    "preview": {
      "anyOf": [
        {
          "$ref": "./AgentImportPreview.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "receivedBytes": {
      "type": "integer"
    }
  },
  "additionalProperties": true,
  "required": [
    "importId",
    "receivedBytes"
  ]
}
