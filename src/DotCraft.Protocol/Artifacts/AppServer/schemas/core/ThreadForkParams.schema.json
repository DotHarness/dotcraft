{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ThreadForkParams.schema.json",
  "title": "ThreadForkParams",
  "type": "object",
  "properties": {
    "additionalContext": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "./RuntimeAdditionalContextEntry.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "config": {
      "anyOf": [
        {
          "$ref": "./ThreadConfiguration.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "cwd": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "displayName": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "dynamicTools": {
      "anyOf": [
        {
          "type": "array",
          "items": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "ephemeral": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "forkPoint": {
      "anyOf": [
        {
          "$ref": "./ThreadForkPoint.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "identity": {
      "anyOf": [
        {
          "$ref": "./SessionIdentity.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtimeWorkspaceRoots": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
