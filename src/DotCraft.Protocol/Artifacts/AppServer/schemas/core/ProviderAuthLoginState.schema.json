{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ProviderAuthLoginState.schema.json",
  "title": "ProviderAuthLoginState",
  "type": "object",
  "properties": {
    "authentication": {
      "anyOf": [
        {
          "$ref": "./ProviderAuthStatusResult.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorMessage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "event": {
      "anyOf": [
        {
          "$ref": "./ProviderAuthEvent.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "loginId": {
      "type": "string"
    },
    "prompt": {
      "anyOf": [
        {
          "$ref": "./ProviderAuthPrompt.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "promptId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "providerId": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "loginId",
    "providerId",
    "revision",
    "status"
  ]
}
