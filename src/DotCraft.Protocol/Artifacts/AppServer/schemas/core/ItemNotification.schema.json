{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ItemNotification.schema.json",
  "title": "ItemNotification",
  "type": "object",
  "properties": {
    "item": {
      "$ref": "./SessionItem.schema.json"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "item",
    "threadId"
  ]
}
