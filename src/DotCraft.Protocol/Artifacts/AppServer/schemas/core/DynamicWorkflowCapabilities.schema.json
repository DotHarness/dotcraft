{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/DynamicWorkflowCapabilities.schema.json",
  "title": "DynamicWorkflowCapabilities",
  "type": "object",
  "properties": {
    "list": {
      "type": "boolean"
    },
    "notifications": {
      "type": "boolean"
    },
    "pause": {
      "type": "boolean"
    },
    "read": {
      "type": "boolean"
    },
    "resume": {
      "type": "boolean"
    },
    "stop": {
      "type": "boolean"
    },
    "version": {
      "type": "integer"
    }
  },
  "additionalProperties": true,
  "required": [
    "list",
    "notifications",
    "pause",
    "read",
    "resume",
    "stop",
    "version"
  ]
}
