{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ErrorPayload.schema.json",
  "title": "ErrorPayload",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "fatal": {
      "type": "boolean"
    },
    "httpStatus": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string"
    },
    "providerError": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "code",
    "fatal",
    "message"
  ]
}
