{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/PluginListResult.schema.json",
  "title": "PluginListResult",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "./PluginDiagnostic.schema.json"
      }
    },
    "marketplaces": {
      "type": "array",
      "items": {
        "$ref": "./MarketplaceInfo.schema.json"
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "./PluginInfo.schema.json"
      }
    },
    "snapshotRevision": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "additionalProperties": true
}
