{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ChannelChat.schema.json",
  "title": "ChannelChat",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "membership": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "kind",
    "membership"
  ]
}
