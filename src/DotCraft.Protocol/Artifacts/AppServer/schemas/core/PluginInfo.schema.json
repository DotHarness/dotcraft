{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/PluginInfo.schema.json",
  "title": "PluginInfo",
  "type": "object",
  "properties": {
    "apps": {
      "type": "array",
      "items": {
        "$ref": "./PluginAppInfo.schema.json"
      }
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "desktopExtensions": {
      "type": "array",
      "items": {
        "$ref": "./PluginDesktopExtensionInfo.schema.json"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "./PluginDiagnostic.schema.json"
      }
    },
    "displayName": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "./PluginFunctionInfo.schema.json"
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "$ref": "./PluginHookInfo.schema.json"
      }
    },
    "id": {
      "type": "string"
    },
    "installable": {
      "type": "boolean"
    },
    "installed": {
      "type": "boolean"
    },
    "interface": {
      "anyOf": [
        {
          "$ref": "./PluginInterface.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "lspServers": {
      "type": "array",
      "items": {
        "$ref": "./PluginLspServerInfo.schema.json"
      }
    },
    "marketplaceName": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "mcpServers": {
      "type": "array",
      "items": {
        "$ref": "./PluginMcpServerInfo.schema.json"
      }
    },
    "removable": {
      "type": "boolean"
    },
    "rootPath": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "./PluginSkillInfo.schema.json"
      }
    },
    "source": {
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "./PluginWorkflowInfo.schema.json"
      }
    }
  },
  "additionalProperties": true
}
