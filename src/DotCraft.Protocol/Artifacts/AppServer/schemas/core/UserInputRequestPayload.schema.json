{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/UserInputRequestPayload.schema.json",
  "title": "UserInputRequestPayload",
  "type": "object",
  "properties": {
    "isBlocking": {
      "type": "boolean"
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "./UserInputQuestion.schema.json"
      }
    },
    "requestId": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "isBlocking",
    "questions",
    "requestId"
  ]
}
