{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ImportSelection.schema.json",
  "title": "ImportSelection",
  "type": "object",
  "properties": {
    "all": {
      "type": "boolean"
    },
    "sessions": {
      "type": "boolean"
    },
    "user": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workspace": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "all",
    "sessions",
    "user",
    "workspace"
  ]
}
