{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ProviderAuthUsageResult.schema.json",
  "title": "ProviderAuthUsageResult",
  "type": "object",
  "properties": {
    "available": {
      "type": "boolean"
    },
    "credits": {
      "anyOf": [
        {
          "$ref": "./ProviderAuthUsageCredits.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "fetchedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitReachedKind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "planType": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "primary": {
      "anyOf": [
        {
          "$ref": "./ProviderAuthUsageWindow.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "secondary": {
      "anyOf": [
        {
          "$ref": "./ProviderAuthUsageWindow.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "available"
  ]
}
