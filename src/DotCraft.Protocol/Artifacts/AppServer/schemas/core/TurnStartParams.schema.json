{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/TurnStartParams.schema.json",
  "title": "TurnStartParams",
  "type": "object",
  "properties": {
    "clientUserMessageId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "cwd": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "input": {
      "type": "array",
      "items": {
        "$ref": "./InputPart.schema.json"
      }
    },
    "messages": {},
    "mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "providerId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasoning": {
      "anyOf": [
        {
          "$ref": "./ReasoningConfig.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtimeWorkspaceRoots": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sender": {
      "anyOf": [
        {
          "$ref": "./SenderContext.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "sentAsGoal": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "speed": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "input",
    "threadId"
  ]
}
