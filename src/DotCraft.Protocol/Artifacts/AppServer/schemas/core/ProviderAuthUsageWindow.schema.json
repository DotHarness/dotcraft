{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ProviderAuthUsageWindow.schema.json",
  "title": "ProviderAuthUsageWindow",
  "type": "object",
  "properties": {
    "resetAt": {
      "type": "string",
      "format": "date-time"
    },
    "usedPercent": {
      "type": "integer"
    },
    "windowSeconds": {
      "type": "integer"
    }
  },
  "additionalProperties": true,
  "required": [
    "resetAt",
    "usedPercent",
    "windowSeconds"
  ]
}
