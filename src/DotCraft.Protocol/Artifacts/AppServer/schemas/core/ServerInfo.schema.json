{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ServerInfo.schema.json",
  "title": "ServerInfo",
  "type": "object",
  "properties": {
    "extensions": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "protocolVersion": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "name",
    "protocolVersion",
    "version"
  ]
}
