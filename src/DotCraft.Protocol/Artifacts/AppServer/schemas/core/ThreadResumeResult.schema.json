{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ThreadResumeResult.schema.json",
  "title": "ThreadResumeResult",
  "type": "object",
  "properties": {
    "currentState": {
      "$ref": "./ThreadResumeCurrentState.schema.json"
    },
    "initialTurnsPage": {
      "anyOf": [
        {
          "$ref": "./ThreadTurnsListResult.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "instructionSources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "itemsBackwardsCursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "thread": {
      "$ref": "./SessionThread.schema.json"
    },
    "turnsBackwardsCursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "currentState",
    "instructionSources",
    "thread"
  ]
}
