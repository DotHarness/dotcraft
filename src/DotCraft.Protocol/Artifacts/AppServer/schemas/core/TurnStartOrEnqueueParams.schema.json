{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/TurnStartOrEnqueueParams.schema.json",
  "title": "TurnStartOrEnqueueParams",
  "type": "object",
  "properties": {
    "input": {
      "type": "array",
      "items": {
        "$ref": "./InputPart.schema.json"
      }
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasoning": {
      "anyOf": [
        {
          "$ref": "./ReasoningConfig.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "input",
    "threadId"
  ]
}
