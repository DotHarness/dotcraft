{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/PluginConfigField.schema.json",
  "title": "PluginConfigField",
  "type": "object",
  "properties": {
    "defaultValue": {},
    "key": {
      "type": "string"
    },
    "max": {
      "type": "number"
    },
    "min": {
      "type": "number"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "key",
    "type"
  ]
}
