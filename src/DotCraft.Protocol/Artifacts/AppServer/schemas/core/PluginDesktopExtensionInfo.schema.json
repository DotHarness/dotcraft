{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/PluginDesktopExtensionInfo.schema.json",
  "title": "PluginDesktopExtensionInfo",
  "type": "object",
  "properties": {
    "connectOrigins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "displayName": {
      "type": "string"
    },
    "entry": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "requiredAppIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surfaceWriteScopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "$ref": "./PluginDesktopExtensionSurface.schema.json"
      }
    }
  },
  "additionalProperties": true
}
