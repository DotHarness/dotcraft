{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ConfigWriteResult.schema.json",
  "title": "ConfigWriteResult",
  "type": "object",
  "properties": {
    "filePath": {
      "type": "string"
    },
    "overriddenMetadata": {
      "anyOf": [
        {
          "$ref": "./ConfigOverriddenMetadata.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "filePath",
    "status",
    "version"
  ]
}
