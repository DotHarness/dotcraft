{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/RemoteToolRouteInfo.schema.json",
  "title": "RemoteToolRouteInfo",
  "type": "object",
  "properties": {
    "environment": {
      "anyOf": [
        {
          "$ref": "./RemoteToolEnvironmentInfo.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "hostId": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "hostId",
    "status",
    "threadId",
    "workspaceId"
  ]
}
