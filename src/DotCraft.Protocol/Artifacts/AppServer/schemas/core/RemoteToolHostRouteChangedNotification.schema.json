{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/RemoteToolHostRouteChangedNotification.schema.json",
  "title": "RemoteToolHostRouteChangedNotification",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string"
    },
    "route": {
      "anyOf": [
        {
          "$ref": "./RemoteToolRouteInfo.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "reason",
    "threadId"
  ]
}
