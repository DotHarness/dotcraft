{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/DynamicToolCallPayload.schema.json",
  "title": "DynamicToolCallPayload",
  "type": "object",
  "properties": {
    "arguments": {},
    "bindingRevision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "callId": {
      "type": "string"
    },
    "contentItems": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "./DynamicToolContentItem.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "durationMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorMessage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "namespace": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "presentation": {
      "anyOf": [
        {
          "$ref": "./ToolPresentationPayload.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "providerFlatName": {
      "type": "string"
    },
    "runtimeBindingId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshotRevision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "anyOf": [
        {
          "$ref": "./ToolSourceProvenancePayload.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string"
    },
    "structuredContent": {},
    "success": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "toolDefinitionId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "toolName": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "callId",
    "providerFlatName",
    "status",
    "toolName"
  ]
}
