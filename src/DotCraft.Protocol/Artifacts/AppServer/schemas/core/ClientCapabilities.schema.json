{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ClientCapabilities.schema.json",
  "title": "ClientCapabilities",
  "type": "object",
  "properties": {
    "acpExtensions": {
      "anyOf": [
        {
          "$ref": "./AcpExtensionCapability.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "appBindingVersion": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "approvalSupport": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "backgroundTerminals": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "browserUse": {
      "anyOf": [
        {
          "$ref": "./BrowserUseCapability.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "channelAdapter": {
      "anyOf": [
        {
          "$ref": "./ChannelAdapterCapability.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "commandExecutionStreaming": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "configChange": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "inlineVisualizations": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "interactiveToolUi": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "mcpApps": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "mcpElicitation": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "nodeRepl": {
      "anyOf": [
        {
          "$ref": "./NodeReplCapability.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "optOutNotificationMethods": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "requestUserInputSupport": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "streamingSupport": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "toolExecutionLifecycle": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true
}
