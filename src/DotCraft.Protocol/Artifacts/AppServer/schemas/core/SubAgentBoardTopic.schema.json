{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/SubAgentBoardTopic.schema.json",
  "title": "SubAgentBoardTopic",
  "type": "object",
  "properties": {
    "channelName": {
      "type": "string"
    },
    "lastActivityAt": {
      "type": "string",
      "format": "date-time"
    },
    "replyCount": {
      "type": "integer"
    },
    "rootPost": {
      "$ref": "./SubAgentBoardPost.schema.json"
    },
    "topicId": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
