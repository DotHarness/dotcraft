{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/PluginOperationResult.schema.json",
  "title": "PluginOperationResult",
  "type": "object",
  "properties": {
    "affectedPlugins": {
      "type": "array",
      "items": {
        "$ref": "./PluginRuntimeProjection.schema.json"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "./PluginDiagnostic.schema.json"
      }
    },
    "outcome": {
      "type": "string"
    },
    "plugin": {
      "anyOf": [
        {
          "$ref": "./PluginInfo.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshotRevision": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "additionalProperties": true
}
