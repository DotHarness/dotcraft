{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/AgentExportPackage.schema.json",
  "title": "AgentExportPackage",
  "type": "object",
  "properties": {
    "bytes": {
      "type": "integer"
    },
    "displayName": {
      "type": "string"
    },
    "dotnet": {
      "type": "boolean"
    },
    "kind": {
      "type": "string"
    },
    "marketplaceName": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "bytes",
    "displayName",
    "dotnet",
    "kind",
    "name",
    "reasons"
  ]
}
