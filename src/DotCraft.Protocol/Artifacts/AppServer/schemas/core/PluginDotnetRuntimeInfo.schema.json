{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/PluginDotnetRuntimeInfo.schema.json",
  "title": "PluginDotnetRuntimeInfo",
  "type": "object",
  "properties": {
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "./PluginRuntimeBlocker.schema.json"
      }
    },
    "generationId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "leakedGenerations": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "restartRecommended": {
      "type": "boolean"
    },
    "state": {
      "type": "string"
    },
    "trustStatus": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
