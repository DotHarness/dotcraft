{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ThreadResumeParams.schema.json",
  "title": "ThreadResumeParams",
  "type": "object",
  "properties": {
    "additionalContext": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "./RuntimeAdditionalContextEntry.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "cwd": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "dynamicTools": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "./RuntimeDynamicToolDeclaration.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "runtimeWorkspaceRoots": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "threadId"
  ]
}
