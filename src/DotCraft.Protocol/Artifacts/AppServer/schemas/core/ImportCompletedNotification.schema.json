{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ImportCompletedNotification.schema.json",
  "title": "ImportCompletedNotification",
  "type": "object",
  "properties": {
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "importId": {
      "type": "string"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "./ImportOutcome.schema.json"
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "trigger": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "completedAt",
    "importId",
    "outcomes",
    "startedAt",
    "trigger"
  ]
}
