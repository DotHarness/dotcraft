{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ConfigReadResult.schema.json",
  "title": "ConfigReadResult",
  "type": "object",
  "properties": {
    "config": {},
    "layers": {
      "type": "array",
      "items": {
        "$ref": "./ConfigLayer.schema.json"
      }
    },
    "origins": {
      "type": "object",
      "additionalProperties": {
        "$ref": "./ConfigLayerMetadata.schema.json"
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "config",
    "origins"
  ]
}
