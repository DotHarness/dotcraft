{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/RuntimeDynamicToolFunction.schema.json",
  "title": "RuntimeDynamicToolFunction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "function"
    },
    "approval": {
      "anyOf": [
        {
          "$ref": "./ToolApprovalDescriptor.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "deferLoading": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "inputSchema": {},
    "name": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "description",
    "name",
    "type"
  ]
}
