{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/AgentImportCommitParams.schema.json",
  "title": "AgentImportCommitParams",
  "type": "object",
  "properties": {
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "importId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "./AgentPackageRef.schema.json"
      }
    },
    "source": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "importId",
    "name",
    "packages",
    "source"
  ]
}
