{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/app-binding/AppInfo.schema.json",
  "title": "AppInfo",
  "type": "object",
  "properties": {
    "accountLabel": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "appId": {
      "type": "string"
    },
    "bindingSummary": {
      "anyOf": [
        {
          "$ref": "./ThreadAppBindingSummary.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "catalogVisible": {
      "type": "boolean"
    },
    "category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "connectionState": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "developerName": {
      "type": "string"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "./PluginDiagnostic.schema.json"
      }
    },
    "displayName": {
      "type": "string"
    },
    "downloadUrl": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "handoffModes": {
      "type": "array",
      "items": {
        "$ref": "./AppHandoffModeDescriptor.schema.json"
      }
    },
    "icon": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "installed": {
      "type": "boolean"
    },
    "managed": {
      "type": "boolean"
    },
    "nativeApp": {
      "$ref": "./AppNativeApplication.schema.json"
    },
    "pluginId": {
      "type": "string"
    },
    "releasePage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "requiresExternalConnection": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
