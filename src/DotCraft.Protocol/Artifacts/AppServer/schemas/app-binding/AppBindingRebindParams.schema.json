{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/app-binding/AppBindingRebindParams.schema.json",
  "title": "AppBindingRebindParams",
  "type": "object",
  "properties": {
    "authorityRevision": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "bearer": {
      "type": "string"
    },
    "bearerExpiresAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "bindingId": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
