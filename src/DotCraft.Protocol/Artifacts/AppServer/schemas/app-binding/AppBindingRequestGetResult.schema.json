{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/app-binding/AppBindingRequestGetResult.schema.json",
  "title": "AppBindingRequestGetResult",
  "type": "object",
  "properties": {
    "appId": {
      "type": "string"
    },
    "bindingKind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "bindingRequestId": {
      "type": "string"
    },
    "developerName": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "dynamicToolCatalog": {
      "$ref": "./AppDynamicToolCatalogDescriptor.schema.json"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "requestedScopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requestedTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scopeCatalog": {
      "type": "array",
      "items": {
        "$ref": "./AppScopeDescriptor.schema.json"
      }
    },
    "socialIntent": {
      "anyOf": [
        {
          "$ref": "./SocialBindingIntent.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    },
    "threadTitle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "toolCatalog": {
      "type": "array",
      "items": {
        "$ref": "./AppToolCatalogEntry.schema.json"
      }
    }
  },
  "additionalProperties": true
}
