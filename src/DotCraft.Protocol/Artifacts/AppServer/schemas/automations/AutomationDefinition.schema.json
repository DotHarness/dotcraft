{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/automations/AutomationDefinition.schema.json",
  "title": "AutomationDefinition",
  "type": "object",
  "properties": {
    "agentProfileId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "approvalPolicy": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "executionMode": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "nextRunAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "notificationPolicy": {
      "type": "string"
    },
    "origin": {
      "anyOf": [
        {
          "$ref": "./AutomationOrigin.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt": {
      "type": "string"
    },
    "schedule": {
      "$ref": "./AutomationSchedule.schema.json"
    },
    "status": {
      "type": "string"
    },
    "targetThreadId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer"
    },
    "workspaceMode": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "approvalPolicy",
    "createdAt",
    "executionMode",
    "id",
    "name",
    "notificationPolicy",
    "prompt",
    "schedule",
    "status",
    "updatedAt",
    "version",
    "workspaceMode"
  ]
}
