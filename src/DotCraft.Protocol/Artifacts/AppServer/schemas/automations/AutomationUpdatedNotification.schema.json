{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/automations/AutomationUpdatedNotification.schema.json",
  "title": "AutomationUpdatedNotification",
  "type": "object",
  "properties": {
    "automation": {
      "anyOf": [
        {
          "$ref": "./AutomationDefinition.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "automationId": {
      "type": "string"
    },
    "removed": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "required": [
