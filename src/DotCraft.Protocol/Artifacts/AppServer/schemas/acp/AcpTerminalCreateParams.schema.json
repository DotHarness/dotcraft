{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/acp/AcpTerminalCreateParams.schema.json",
  "title": "AcpTerminalCreateParams",
  "type": "object",
  "properties": {
    "args": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "command": {
      "type": "string"
    },
    "cwd": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "env": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "./AcpEnvVariable.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "outputByteLimit": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
