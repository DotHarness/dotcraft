{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/app-binding/ThreadAppBindingEnableResult.schema.json",
  "title": "ThreadAppBindingEnableResult",
  "type": "object",
  "properties": {
    "bindingId": {
      "type": "string"
    },
    "bindingRequestId": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "handoff": {
      "anyOf": [
        {
          "$ref": "./AppHandoffWire.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
