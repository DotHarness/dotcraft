{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/teams/TeamTaskRecord.schema.json",
  "title": "TeamTaskRecord",
  "type": "object",
  "properties": {
    "alias": {
      "type": "string"
    },
    "assigneeMemberId": {
      "type": "string"
    },
    "blockedOnTaskIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockedReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "completionRecoveryAttempts": {
      "type": "integer"
    },
    "completionRecoveryPending": {
      "type": "boolean"
    },
    "completionRecoveryQueuedInputId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "dependsOnTaskIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "digest": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "latestUpdate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "leaderNotifiedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata": {},
    "missionId": {
      "type": "string"
    },
    "outputSummary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt": {
      "type": "string"
    },
    "queuedInputId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "requiredForMission": {
      "type": "boolean"
    },
    "requiresLeaderSynthesis": {
      "type": "boolean"
    },
    "status": {
      "type": "string"
    },
    "synthesisMessageId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "taskId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
