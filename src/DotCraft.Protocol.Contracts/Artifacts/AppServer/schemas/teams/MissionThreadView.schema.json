{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/teams/MissionThreadView.schema.json",
  "title": "MissionThreadView",
  "type": "object",
  "properties": {
    "archivedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "currentTaskId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "memberId": {
      "type": "string"
    },
    "missionId": {
      "type": "string"
    },
    "queuedInputCount": {
      "type": "integer"
    },
    "queuedInputId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "running": {
      "type": "boolean"
    },
    "status": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "waitingOnApproval": {
      "type": "boolean"
    },
    "waitingOnInput": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
