{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/teams/TeamMessageRecord.schema.json",
  "title": "TeamMessageRecord",
  "type": "object",
  "properties": {
    "artifactIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "deliveredAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "deliveredQueuedInputId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "fromMemberId": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "messageId": {
      "type": "string"
    },
    "metadata": {},
    "missionId": {
      "type": "string"
    },
    "requiresAction": {
      "type": "boolean"
    },
    "status": {
      "type": "string"
    },
    "taskId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "toMemberId": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
