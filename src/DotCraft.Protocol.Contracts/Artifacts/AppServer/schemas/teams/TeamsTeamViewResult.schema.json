{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/teams/TeamsTeamViewResult.schema.json",
  "title": "TeamsTeamViewResult",
  "type": "object",
  "properties": {
    "archivedMissions": {
      "type": "array",
      "items": {
        "$ref": "./MissionRecord.schema.json"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "./ArtifactRefRecord.schema.json"
      }
    },
    "mailboxDigests": {
      "type": "array",
      "items": {
        "$ref": "./MailboxDigestRecord.schema.json"
      }
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "./TeamMemberView.schema.json"
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "./TeamMessageRecord.schema.json"
      }
    },
    "missionThreads": {
      "type": "array",
      "items": {
        "$ref": "./MissionThreadView.schema.json"
      }
    },
    "missions": {
      "type": "array",
      "items": {
        "$ref": "./MissionRecord.schema.json"
      }
    },
    "stats": {
      "$ref": "./TeamsTeamStats.schema.json"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "./TeamTaskRecord.schema.json"
      }
    },
    "team": {
      "anyOf": [
        {
          "$ref": "./TeamRecord.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true
}
