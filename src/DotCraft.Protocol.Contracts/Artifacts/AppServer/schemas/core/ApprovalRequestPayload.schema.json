{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ApprovalRequestPayload.schema.json",
  "title": "ApprovalRequestPayload",
  "type": "object",
  "properties": {
    "approvalType": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "requestId": {
      "type": "string"
    },
    "scopeKey": {
      "type": "string"
    },
    "target": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "approvalType",
    "expiresAt",
    "operation",
    "reason",
    "requestId",
    "scopeKey",
    "target"
  ]
}
