{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ThreadStartParams.schema.json",
  "title": "ThreadStartParams",
  "type": "object",
  "properties": {
    "additionalContext": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "./RuntimeAdditionalContextEntry.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "config": {
      "anyOf": [
        {
          "$ref": "./ThreadConfiguration.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "cwd": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "displayName": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "dynamicTools": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "./RuntimeDynamicToolDeclaration.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "historyMode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "identity": {
      "$ref": "./SessionIdentity.schema.json"
    },
    "runtimeWorkspaceRoots": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "spawnedFromThreadId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "identity"
  ]
}
