{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ThreadGoal.schema.json",
  "title": "ThreadGoal",
  "type": "object",
  "properties": {
    "createdAt": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "objective": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    },
    "timeUsedSeconds": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "tokenBudget": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "tokensUsed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "additionalProperties": true,
  "required": [
    "createdAt",
    "objective",
    "status",
    "threadId",
    "timeUsedSeconds",
    "tokensUsed",
    "updatedAt"
  ]
}
