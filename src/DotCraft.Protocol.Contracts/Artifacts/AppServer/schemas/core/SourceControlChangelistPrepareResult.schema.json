{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/SourceControlChangelistPrepareResult.schema.json",
  "title": "SourceControlChangelistPrepareResult",
  "type": "object",
  "properties": {
    "changelist": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "created": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "./SourceControlDiagnosticItem.schema.json"
      }
    },
    "movedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skippedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "./SourceControlDiagnosticItem.schema.json"
      }
    }
  },
  "additionalProperties": true
}
