{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ModelCatalogItem.schema.json",
  "title": "ModelCatalogItem",
  "type": "object",
  "properties": {
    "contextWindow": {
      "anyOf": [
        {
          "$ref": "./ModelContextWindowCapabilityWire.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "type": "string"
    },
    "ownedBy": {
      "type": "string"
    },
    "reasoning": {
      "anyOf": [
        {
          "$ref": "./ModelReasoningCapability.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "speed": {
      "anyOf": [
        {
          "$ref": "./ModelSpeedCapability.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true
}
