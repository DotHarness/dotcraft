{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ChannelAdapterCapability.schema.json",
  "title": "ChannelAdapterCapability",
  "type": "object",
  "properties": {
    "channelName": {
      "type": "string"
    },
    "deliverySupport": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "channelName"
  ]
}
