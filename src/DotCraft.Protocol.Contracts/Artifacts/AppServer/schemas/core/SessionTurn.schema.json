{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/SessionTurn.schema.json",
  "title": "SessionTurn",
  "type": "object",
  "properties": {
    "completedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "initiator": {
      "anyOf": [
        {
          "$ref": "./TurnInitiatorContext.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "./SessionItem.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "originChannel": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    },
    "tokenUsage": {
      "anyOf": [
        {
          "$ref": "./TokenUsageInfo.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "id",
    "startedAt",
    "status",
    "threadId"
  ]
}
