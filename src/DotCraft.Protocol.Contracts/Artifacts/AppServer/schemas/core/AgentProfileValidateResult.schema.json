{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/AgentProfileValidateResult.schema.json",
  "title": "AgentProfileValidateResult",
  "type": "object",
  "properties": {
    "compiledConfig": {
      "anyOf": [
        {
          "$ref": "./ThreadConfiguration.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "./AgentProfileDiagnosticWire.schema.json"
      }
    },
    "lockedFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "providerPreference": {
      "anyOf": [
        {
          "$ref": "./AgentProfileProviderPreferenceWire.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "restrictedFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "$ref": "./AgentProfileSummaryWire.schema.json"
    },
    "valid": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
