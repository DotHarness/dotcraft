{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ConfigSchemaSection.schema.json",
  "title": "ConfigSchemaSection",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "$ref": "./ConfigSchemaField.schema.json"
      }
    },
    "itemFields": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "./ConfigSchemaField.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "order": {
      "type": "integer"
    },
    "path": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "rootKey": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "section": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "fields",
    "section"
  ]
}
