{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/AgentProfileEntryWire.schema.json",
  "title": "AgentProfileEntryWire",
  "type": "object",
  "properties": {
    "avatar": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "compiledConfig": {
      "anyOf": [
        {
          "$ref": "./ThreadConfiguration.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "./AgentProfileDiagnosticWire.schema.json"
      }
    },
    "fingerprint": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "isBuiltIn": {
      "type": "boolean"
    },
    "lockedFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "pluginId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "providerPreference": {
      "anyOf": [
        {
          "$ref": "./AgentProfileProviderPreferenceWire.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "rawContent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "readOnly": {
      "type": "boolean"
    },
    "restrictedFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shadowed": {
      "type": "boolean"
    },
    "shadowedBy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string"
    },
    "sourceStack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "staleThreadIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trustRestricted": {
      "type": "boolean"
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
