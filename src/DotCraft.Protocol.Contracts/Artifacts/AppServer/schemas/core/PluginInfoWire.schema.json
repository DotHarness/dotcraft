{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/PluginInfoWire.schema.json",
  "title": "PluginInfoWire",
  "type": "object",
  "properties": {
    "apps": {
      "type": "array",
      "items": {
        "$ref": "./PluginAppInfoWire.schema.json"
      }
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "desktopExtensions": {
      "type": "array",
      "items": {
        "$ref": "./PluginDesktopExtensionInfoWire.schema.json"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "./PluginDiagnosticWire.schema.json"
      }
    },
    "displayName": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "./PluginFunctionInfoWire.schema.json"
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "$ref": "./PluginHookInfoWire.schema.json"
      }
    },
    "id": {
      "type": "string"
    },
    "installable": {
      "type": "boolean"
    },
    "installed": {
      "type": "boolean"
    },
    "interface": {
      "anyOf": [
        {
          "$ref": "./PluginInterfaceWire.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "lspServers": {
      "type": "array",
      "items": {
        "$ref": "./PluginLspServerInfoWire.schema.json"
      }
    },
    "marketplaceName": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "mcpServers": {
      "type": "array",
      "items": {
        "$ref": "./PluginMcpServerInfoWire.schema.json"
      }
    },
    "removable": {
      "type": "boolean"
    },
    "rootPath": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "./PluginSkillInfoWire.schema.json"
      }
    },
    "source": {
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true
}
