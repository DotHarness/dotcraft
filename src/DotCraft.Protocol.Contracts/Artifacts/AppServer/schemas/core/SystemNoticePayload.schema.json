{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/SystemNoticePayload.schema.json",
  "title": "SystemNoticePayload",
  "type": "object",
  "properties": {
    "clearedToolResults": {
      "type": "integer"
    },
    "kind": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "percentLeftAfter": {
      "type": "number"
    },
    "sourceThreadId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "tokensAfter": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "tokensBefore": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "trigger": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "clearedToolResults",
    "kind",
    "mode",
    "percentLeftAfter",
    "tokensAfter",
    "tokensBefore",
    "trigger"
  ]
}
