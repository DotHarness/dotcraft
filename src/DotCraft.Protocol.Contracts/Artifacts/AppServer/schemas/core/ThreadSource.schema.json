{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ThreadSource.schema.json",
  "title": "ThreadSource",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string"
    },
    "spawnedFromThreadId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "subAgent": {
      "anyOf": [
        {
          "$ref": "./SubAgentThreadSource.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "kind"
  ]
}
