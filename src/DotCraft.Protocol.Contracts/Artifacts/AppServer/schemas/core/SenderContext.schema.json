{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/SenderContext.schema.json",
  "title": "SenderContext",
  "type": "object",
  "properties": {
    "groupId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "senderId": {
      "type": "string"
    },
    "senderName": {
      "type": "string"
    },
    "senderRole": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "senderId",
    "senderName",
    "senderRole"
  ]
}
