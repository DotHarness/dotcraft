{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/McpServerRuntimeStatusWire.schema.json",
  "title": "McpServerRuntimeStatusWire",
  "type": "object",
  "properties": {
    "authState": {
      "type": "string"
    },
    "authStatus": {
      "type": "string"
    },
    "declaredName": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "failureReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "generation": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "lastError": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "origin": {
      "anyOf": [
        {
          "$ref": "./McpServerOriginWire.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "resourceCount": {
      "type": "integer"
    },
    "resourceTemplateCount": {
      "type": "integer"
    },
    "resourceTemplates": {
      "type": "array",
      "items": {}
    },
    "resources": {
      "type": "array",
      "items": {}
    },
    "runtimeName": {
      "type": "string"
    },
    "serverInfo": {},
    "startupState": {
      "type": "string"
    },
    "toolCount": {
      "type": "integer"
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "$ref": "./McpRuntimeToolWire.schema.json"
      }
    },
    "transport": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
