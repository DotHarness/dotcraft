{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/CommandExecuteParams.schema.json",
  "title": "CommandExecuteParams",
  "type": "object",
  "properties": {
    "arguments": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "command": {
      "type": "string"
    },
    "sender": {
      "anyOf": [
        {
          "$ref": "./SenderContext.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
