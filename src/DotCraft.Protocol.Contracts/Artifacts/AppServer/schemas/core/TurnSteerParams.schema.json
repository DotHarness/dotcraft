{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/TurnSteerParams.schema.json",
  "title": "TurnSteerParams",
  "type": "object",
  "properties": {
    "expectedTurnId": {
      "type": "string"
    },
    "input": {
      "type": "array",
      "items": {
        "$ref": "./InputPart.schema.json"
      }
    },
    "queuedInputId": {
      "type": "string"
    },
    "sender": {
      "anyOf": [
        {
          "$ref": "./SenderContext.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
