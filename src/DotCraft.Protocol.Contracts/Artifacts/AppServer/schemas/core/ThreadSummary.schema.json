{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ThreadSummary.schema.json",
  "title": "ThreadSummary",
  "type": "object",
  "properties": {
    "displayName": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "turns": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "./SessionTurn.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "workspacePath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "id",
    "status"
  ]
}
