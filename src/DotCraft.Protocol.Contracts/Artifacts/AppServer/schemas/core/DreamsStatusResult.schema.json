{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/DreamsStatusResult.schema.json",
  "title": "DreamsStatusResult",
  "type": "object",
  "properties": {
    "activeDreamStoreId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "autoApply": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    },
    "historyTailChars": {
      "type": "integer"
    },
    "interval": {
      "type": "string"
    },
    "lastRun": {
      "anyOf": [
        {
          "$ref": "./DreamsRunStateWire.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "minCompletedTurnsSinceLastRun": {
      "type": "integer"
    },
    "nextRunAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "running": {
      "type": "boolean"
    },
    "threadLookbackCount": {
      "type": "integer"
    }
  },
  "additionalProperties": true
}
