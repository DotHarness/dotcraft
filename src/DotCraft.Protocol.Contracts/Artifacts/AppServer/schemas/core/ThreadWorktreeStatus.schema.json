{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ThreadWorktreeStatus.schema.json",
  "title": "ThreadWorktreeStatus",
  "type": "object",
  "properties": {
    "aheadCount": {
      "type": "integer"
    },
    "branchName": {
      "type": "string"
    },
    "exists": {
      "type": "boolean"
    },
    "hasCommitsAheadOfBase": {
      "type": "boolean"
    },
    "hasUncommittedChanges": {
      "type": "boolean"
    },
    "head": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "isGitWorktree": {
      "type": "boolean"
    },
    "path": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    },
    "worktree": {
      "$ref": "./ThreadWorktreeInfo.schema.json"
    }
  },
  "additionalProperties": true
}
