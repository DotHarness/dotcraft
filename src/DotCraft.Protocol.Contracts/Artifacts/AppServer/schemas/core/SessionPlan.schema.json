{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/SessionPlan.schema.json",
  "title": "SessionPlan",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "overview": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "todos": {
      "type": "array",
      "items": {
        "$ref": "./SessionPlanTodo.schema.json"
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "content",
    "overview",
    "title",
    "todos"
  ]
}
