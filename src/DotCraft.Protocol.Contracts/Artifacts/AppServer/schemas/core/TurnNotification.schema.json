{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/TurnNotification.schema.json",
  "title": "TurnNotification",
  "type": "object",
  "properties": {
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "turn": {
      "$ref": "./SessionTurn.schema.json"
    }
  },
  "additionalProperties": true,
  "required": [
    "turn"
  ]
}
