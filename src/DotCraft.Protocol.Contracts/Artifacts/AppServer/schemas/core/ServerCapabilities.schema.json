{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/ServerCapabilities.schema.json",
  "title": "ServerCapabilities",
  "type": "object",
  "properties": {
    "approvalFlow": {
      "type": "boolean"
    },
    "dynamicToolRebind": {
      "type": "boolean"
    },
    "extensions": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "requestUserInput": {
      "type": "boolean"
    },
    "runtimeAdditionalContext": {
      "type": "boolean"
    },
    "threadManagement": {
      "type": "boolean"
    },
    "threadSubscriptions": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "required": [
    "threadManagement",
    "threadSubscriptions"
  ]
}
