{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/CommandExecuteResult.schema.json",
  "title": "CommandExecuteResult",
  "type": "object",
  "properties": {
    "archivedThreadIds": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "createdLazily": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "expandedPrompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "handled": {
      "type": "boolean"
    },
    "isMarkdown": {
      "type": "boolean"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessionReset": {
      "type": "boolean"
    },
    "thread": {
      "anyOf": [
        {
          "$ref": "./SessionThread.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true
}
