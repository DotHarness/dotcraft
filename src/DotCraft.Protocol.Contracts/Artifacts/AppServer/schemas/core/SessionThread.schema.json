{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dotcraft.dev/appserver/v1/core/SessionThread.schema.json",
  "title": "SessionThread",
  "type": "object",
  "properties": {
    "appBindings": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "./ThreadAppBindingSummaryWire.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "channelContext": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "configuration": {
      "anyOf": [
        {
          "$ref": "./ThreadConfiguration.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "contextUsage": {
      "anyOf": [
        {
          "$ref": "./ContextUsageSnapshot.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "cwd": {
      "type": "string"
    },
    "displayName": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "effectiveWorkspacePath": {
      "type": "string"
    },
    "ephemeral": {
      "type": "boolean"
    },
    "forkedFromId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "goal": {
      "anyOf": [
        {
          "$ref": "./ThreadGoalWire.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "historyMode": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "lastActiveAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "originApp": {
      "anyOf": [
        {
          "$ref": "./ThreadOriginAppWire.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "originChannel": {
      "type": "string"
    },
    "originPresentation": {
      "anyOf": [
        {
          "$ref": "./ThreadOriginPresentationWire.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "parentThreadId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "./SessionPlan.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "queuedInputs": {
      "type": "array",
      "items": {
        "$ref": "./QueuedTurnInput.schema.json"
      }
    },
    "runtime": {
      "$ref": "./ThreadRuntimeState.schema.json"
    },
    "runtimeWorkspaceRoots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sessionId": {
      "type": "string"
    },
    "source": {
      "$ref": "./ThreadSource.schema.json"
    },
    "status": {
      "type": "string"
    },
    "turns": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "./SessionTurn.schema.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "userId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspacePath": {
      "type": "string"
    },
    "worktree": {
      "anyOf": [
        {
          "$ref": "./ThreadWorktreeInfo.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "createdAt",
    "cwd",
    "effectiveWorkspacePath",
    "ephemeral",
    "historyMode",
    "id",
    "lastActiveAt",
    "metadata",
    "originChannel",
    "queuedInputs",
    "runtime",
    "runtimeWorkspaceRoots",
    "sessionId",
    "source",
    "status",
    "workspacePath",
    "worktree"
  ]
}
