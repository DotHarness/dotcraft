<Window
    x:Class="DotCraft.TraceViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DotCraft.TraceViewer.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:viewModels="using:DotCraft.TraceViewer.ViewModels"
    Title="DotCraft Trace Viewer">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged" ActualThemeChanged="RootGrid_ActualThemeChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="Copy_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <Style x:Key="DetailResizeThumbStyle" TargetType="primitives:Thumb">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="primitives:Thumb">
                            <Grid Background="{TemplateBinding Background}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ResizeHighlight.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ResizeHighlight.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border Width="1" HorizontalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Border
                                    x:Name="ResizeHighlight"
                                    Width="2"
                                    Margin="0,14"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource DetailResizeHighlightBrush}"
                                    Opacity="0" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="ProseDetailBlockTemplate" x:DataType="viewModels:DetailBlockItem">
                <StackPanel Margin="0,0,0,12" Spacing="6">
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource SecondaryTextStyle}" FontWeight="SemiBold" />
                    <TextBlock
                        Text="{x:Bind Value}"
                        Style="{StaticResource UiTextStyle}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="CodeDetailBlockTemplate" x:DataType="viewModels:DetailBlockItem">
                <StackPanel Margin="0,0,0,12" Spacing="6">
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource SecondaryTextStyle}" FontWeight="SemiBold" />
                    <Border Padding="10,8" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <TextBlock
                            Text="{x:Bind Value}"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </DataTemplate>
            <controls:DetailBlockTemplateSelector
                x:Key="DetailBlockSelector"
                ProseTemplate="{StaticResource ProseDetailBlockTemplate}"
                CodeTemplate="{StaticResource CodeDetailBlockTemplate}" />
            <DataTemplate x:Key="TurnHeaderTemplate" x:DataType="viewModels:TurnHeaderItem">
                <Grid MinHeight="38" Padding="8,5" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind ToggleGlyph}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Summary}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ModelCallHeaderTemplate" x:DataType="viewModels:ModelCallHeaderItem">
                <Grid MinHeight="32" Margin="22,0,0,0" Padding="8,3" ColumnSpacing="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind ToggleGlyph}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Summary}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="EventRowTemplate" x:DataType="viewModels:EventRowItem">
                <Grid MinHeight="46" Margin="28,0,0,0" Padding="8,5" ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18" />
                        <RowDefinition Height="18" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Text="{x:Bind Time}"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="11"
                        LineHeight="18"
                        LineStackingStrategy="BlockLineHeight"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Title}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            LineHeight="18"
                            LineStackingStrategy="BlockLineHeight"
                            TextTrimming="CharacterEllipsis" />
                        <Border Padding="5,0" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Badge}" FontSize="10" LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{x:Bind Summary}"
                        FontSize="12"
                        LineHeight="18"
                        LineStackingStrategy="BlockLineHeight"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </DataTemplate>
            <controls:TrajectoryItemTemplateSelector
                x:Key="TrajectoryItemSelector"
                TurnTemplate="{StaticResource TurnHeaderTemplate}"
                ModelCallTemplate="{StaticResource ModelCallHeaderTemplate}"
                EventTemplate="{StaticResource EventRowTemplate}" />
            <DataTemplate x:Key="SessionRowTemplate" x:DataType="viewModels:SessionListItem">
            <Grid MinHeight="70" Padding="10,8" ToolTipService.ToolTip="{x:Bind FullTitle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="{x:Bind DisplayTitle}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis" />
                <Grid Grid.Row="1" Margin="0,3,0,0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{x:Bind SessionKey}"
                        Style="{StaticResource SecondaryTextStyle}"
                        FontFamily="Cascadia Mono, Consolas"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind RelationshipLabel}"
                        Style="{StaticResource SecondaryTextStyle}" />
                </Grid>
                <TextBlock
                    Grid.Row="2"
                    Margin="0,3,0,0"
                    Text="{x:Bind Metrics}"
                    Style="{StaticResource SecondaryTextStyle}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="DotCraft Trace Viewer"
            Subtitle="{x:Bind ViewModel.TitleBarSubtitle, Mode=OneWay}">
            <TitleBar.LeftHeader>
                <Image Width="19" Height="19" VerticalAlignment="Center" Stretch="Uniform">
                    <Image.RenderTransform>
                        <TranslateTransform X="9" Y="-2" />
                    </Image.RenderTransform>
                    <Image.Source>
                        <SvgImageSource UriSource="ms-appx:///Assets/dotcraft-developer.svg" />
                    </Image.Source>
                </Image>
            </TitleBar.LeftHeader>
        </TitleBar>

        <Grid
            Grid.Row="1"
            Padding="32,20,32,28"
            Visibility="{x:Bind ViewModel.IsSessionsPage, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="WorkspaceHeaderGrid" MinHeight="48" ColumnSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="WorkspaceInfoColumn" Width="*" />
                    <ColumnDefinition x:Name="WorkspaceActionsColumn" Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="10,0,0,0" Spacing="5">
                    <TextBlock
                        Text="{x:Bind ViewModel.WorkspaceName, Mode=OneWay}"
                        Style="{StaticResource PageHeadingStyle}" />
                    <TextBlock
                        MaxWidth="760"
                        HorizontalAlignment="Left"
                        Text="{x:Bind ViewModel.WorkspacePath, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel x:Name="WorkspaceActionPanel" Grid.Column="1" Margin="0,0,20,0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Settings"
                        AutomationProperties.Name="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                        <Button.Flyout>
                            <Flyout x:Name="WorkspaceAppearanceFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="220" Spacing="8">
                                    <TextBlock Text="Appearance" Style="{StaticResource SectionHeadingStyle}" />
                                    <TextBlock Text="Choose how Trace Viewer follows Windows colors." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                    <StackPanel Margin="0,4,0,0" Spacing="2">
                                        <Button Style="{StaticResource AppearanceChoiceButtonStyle}" Tag="System" Click="AppearanceOption_Click" AutomationProperties.Name="System appearance">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="System" />
                                                <FontIcon x:Name="SystemAppearanceCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="12" />
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource AppearanceChoiceButtonStyle}" Tag="Light" Click="AppearanceOption_Click" AutomationProperties.Name="Light appearance">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Light" />
                                                <FontIcon x:Name="LightAppearanceCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="12" />
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource AppearanceChoiceButtonStyle}" Tag="Dark" Click="AppearanceOption_Click" AutomationProperties.Name="Dark appearance">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Dark" />
                                                <FontIcon x:Name="DarkAppearanceCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="12" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        Style="{StaticResource IconButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.HasRecentWorkspace, Mode=OneWay}"
                        Click="OpenRecent_Click"
                        ToolTipService.ToolTip="Open recent workspace"
                        AutomationProperties.Name="Open recent workspace">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        </Button.Resources>
                        <FontIcon Glyph="&#xE823;" FontSize="14" />
                    </Button>
                    <Button
                        Style="{StaticResource IconButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                        Click="Refresh_Click"
                        ToolTipService.ToolTip="Refresh sessions"
                        AutomationProperties.Name="Refresh sessions">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        </Button.Resources>
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <Button
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Margin="0,0,10,0"
                        Content="Open workspace"
                        Click="OpenWorkspace_Click">
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E5E5E5" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D6D6D6" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1A1C1F" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#34363A" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#303236" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#44464A" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F1F1F1" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            </ResourceDictionary>
                        </Button.Resources>
                    </Button>
                    <ProgressRing
                        Width="20"
                        Height="20"
                        VerticalAlignment="Bottom"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <StackPanel
                Grid.RowSpan="3"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsWorkspaceClosed, Mode=OneWay}">
                <FontIcon Glyph="&#xE8B7;" FontSize="34" HorizontalAlignment="Center" />
                <TextBlock Text="Inspect a DotCraft workspace" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Open a workspace to browse persisted sessions and their execution traces."
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar
                Grid.Row="1"
                Margin="0,20,0,0"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                IsClosable="False"
                Severity="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid Visibility="{x:Bind ViewModel.IsWorkspaceOpen, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            MaxWidth="560"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ToolbarTextBoxStyle}"
                            PlaceholderText="Search by title, session key, or relationship"
                            Text="{x:Bind ViewModel.SessionSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,10,0"
                            Text="{x:Bind ViewModel.SessionResultsHeading, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.VisibleSessions, Mode=OneWay}"
                        ItemTemplate="{StaticResource SessionRowTemplate}"
                        ItemContainerStyle="{StaticResource CompactListViewItemStyle}"
                        IsItemClickEnabled="True"
                        ItemClick="Session_ItemClick"
                        SelectionChanged="Session_SelectionChanged"
                        SelectionMode="Single" />
                </Grid>
            </Grid>
        </Grid>

        <SplitView
            x:Name="WorkbenchSplitView"
            Grid.Row="1"
            DisplayMode="Inline"
            IsPaneOpen="{x:Bind ViewModel.IsSessionPaneOpen, Mode=TwoWay}"
            OpenPaneLength="264"
            Visibility="{x:Bind ViewModel.IsWorkbenchPage, Mode=OneWay}">
            <SplitView.Pane>
                <Grid Padding="12,8,12,12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Style="{StaticResource ToolbarTextBoxStyle}"
                            PlaceholderText="Search sessions"
                            Text="{x:Bind ViewModel.SessionSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            x:Name="CloseSessionPaneButton"
                            Grid.Column="1"
                            Style="{StaticResource IconButtonStyle}"
                            Click="ToggleSessionPane_Click"
                            ToolTipService.ToolTip="Close sessions"
                            AutomationProperties.Name="Close sessions">
                            <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                        </Button>
                    </Grid>
                    <ListView
                        Grid.Row="1"
                        Margin="0,6,0,0"
                        ItemsSource="{x:Bind ViewModel.VisibleSessions, Mode=OneWay}"
                        ItemTemplate="{StaticResource SessionRowTemplate}"
                        ItemContainerStyle="{StaticResource CompactListViewItemStyle}"
                        SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                        IsItemClickEnabled="True"
                        ItemClick="Session_ItemClick"
                        SelectionChanged="Session_SelectionChanged"
                        SelectionMode="Single" />
                    <Button
                        Grid.Row="2"
                        Height="32"
                        Margin="0,8,0,0"
                        Padding="10,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="PaneAppearanceFlyout" Placement="TopEdgeAlignedLeft">
                                <StackPanel Width="220" Spacing="8">
                                    <TextBlock Text="Appearance" Style="{StaticResource SectionHeadingStyle}" />
                                    <TextBlock Text="Choose how Trace Viewer follows Windows colors." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                    <StackPanel Margin="0,4,0,0" Spacing="2">
                                        <Button Style="{StaticResource AppearanceChoiceButtonStyle}" Tag="System" Click="AppearanceOption_Click" AutomationProperties.Name="System appearance">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="System" />
                                                <FontIcon x:Name="PaneSystemAppearanceCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="12" />
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource AppearanceChoiceButtonStyle}" Tag="Light" Click="AppearanceOption_Click" AutomationProperties.Name="Light appearance">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Light" />
                                                <FontIcon x:Name="PaneLightAppearanceCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="12" />
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource AppearanceChoiceButtonStyle}" Tag="Dark" Click="AppearanceOption_Click" AutomationProperties.Name="Dark appearance">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Dark" />
                                                <FontIcon x:Name="PaneDarkAppearanceCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="12" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </SplitView.Pane>

            <Grid Padding="20,10,20,20" RowSpacing="8" Background="{ThemeResource HarnessContentSurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="WorkbenchHeaderGrid" MinHeight="64" ColumnSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="AllSessionsButton"
                        Style="{StaticResource IconButtonStyle}"
                        Click="ShowSessions_Click"
                        VerticalAlignment="Top"
                        ToolTipService.ToolTip="All sessions"
                        AutomationProperties.Name="All sessions">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <Grid x:Name="SessionTitlePanel" Grid.Column="1" RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="SessionTitleText"
                            Text="{x:Bind ViewModel.SelectedSession.FullTitle, Mode=OneWay, FallbackValue='Session trajectory'}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            MaxLines="2"
                            TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Row="1" ColumnSpacing="8" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                MaxWidth="260"
                                Text="{x:Bind ViewModel.SelectedSessionKey, Mode=OneWay}"
                                Style="{StaticResource SecondaryTextStyle}"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                LineHeight="16"
                                LineStackingStrategy="BlockLineHeight"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="·" Style="{StaticResource SecondaryTextStyle}" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind ViewModel.SelectedActivity, Mode=OneWay}"
                                Style="{StaticResource SecondaryTextStyle}"
                                FontSize="12"
                                LineHeight="16"
                                LineStackingStrategy="BlockLineHeight"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <RadioButton x:Name="TimelineViewButton" GroupName="SessionView" Style="{StaticResource SegmentedOptionStyle}" Content="Timeline" IsChecked="True" Click="SessionMode_Click" />
                            <RadioButton x:Name="ReviewViewButton" GroupName="SessionView" Style="{StaticResource SegmentedOptionStyle}" Content="Review" Click="SessionMode_Click" />
                        </StackPanel>
                        <Button
                            x:Name="SessionPaneButton"
                            Style="{StaticResource IconButtonStyle}"
                            Click="ToggleSessionPane_Click"
                            ToolTipService.ToolTip="Show sessions"
                            AutomationProperties.Name="Show sessions">
                            <FontIcon Glyph="&#xE700;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <InfoBar
                    Grid.Row="1"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    IsClosable="False"
                    Severity="Error"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.IsTimelineMode, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="96" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <RadioButton x:Name="DurationModeButton" GroupName="TimelineScale" Style="{StaticResource SegmentedOptionStyle}" Content="Duration" IsChecked="True" Click="TimelineMode_Click" />
                            <RadioButton x:Name="SequenceModeButton" GroupName="TimelineScale" Style="{StaticResource SegmentedOptionStyle}" Content="Sequence" Click="TimelineMode_Click" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button Style="{StaticResource IconButtonStyle}" Click="TimelineZoomOut_Click" ToolTipService.ToolTip="Zoom out" AutomationProperties.Name="Zoom out">
                                <FontIcon Glyph="&#xE738;" FontSize="12" />
                            </Button>
                            <TextBlock Width="44" Text="{x:Bind ViewModel.TimelineZoomLabel, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" VerticalAlignment="Center" />
                            <Button Style="{StaticResource IconButtonStyle}" Click="TimelineZoomIn_Click" ToolTipService.ToolTip="Zoom in" AutomationProperties.Name="Zoom in">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <controls:TimelineOverview
                        x:Name="TimelineControl"
                        Grid.Row="1"
                        Height="96"
                        Items="{x:Bind ViewModel.TimelineMarkers, Mode=OneWay}"
                        SelectedRowId="{x:Bind ViewModel.SelectedEvent.Id, Mode=OneWay}"
                        ScaleMode="{x:Bind ViewModel.TimelineScaleMode, Mode=OneWay}"
                        ZoomFactor="{x:Bind ViewModel.TimelineZoomFactor, Mode=OneWay}"
                        MarkerSelected="Timeline_MarkerSelected"
                        RangeChanged="Timeline_RangeChanged" />
                </Grid>

                <Grid Grid.Row="3" Visibility="{x:Bind ViewModel.IsTimelineMode, Mode=OneWay}" MinHeight="32" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="EventSearchBox" Style="{StaticResource ToolbarTextBoxStyle}" PlaceholderText="Search events" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="1" Width="112" Height="32" MinHeight="32" FontSize="13" ItemsSource="{x:Bind ViewModel.EventFilters, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedEventFilter, Mode=TwoWay}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <Button
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="{x:Bind ViewModel.LoadOlderButtonText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowLoadOlderEvents, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanLoadOlderEvents, Mode=OneWay}"
                            Click="LoadOlder_Click"
                            AutomationProperties.Name="Load older events" />
                        <Button
                            x:Name="EventDetailButton"
                            Style="{StaticResource IconButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.HasSelectedEvent, Mode=OneWay}"
                            Click="ToggleEventDetail_Click"
                            ToolTipService.ToolTip="Event details"
                            AutomationProperties.Name="Event details">
                            <FontIcon Glyph="&#xE946;" FontSize="14" />
                        </Button>
                        <TextBlock x:Name="EventWindowLabel" Text="{x:Bind ViewModel.EventWindowLabel, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <SplitView
                    x:Name="EventDetailSplitView"
                    Grid.Row="4"
                    Visibility="{x:Bind ViewModel.IsTimelineMode, Mode=OneWay}"
                    PanePlacement="Right"
                    DisplayMode="Overlay"
                    IsPaneOpen="False"
                    OpenPaneLength="440"
                    PaneBackground="{ThemeResource HarnessContentSurfaceBrush}">
                    <SplitView.Content>
                    <ListView
                        x:Name="EventList"
                        ItemsSource="{x:Bind ViewModel.VisibleTrajectory, Mode=OneWay}"
                        ItemTemplateSelector="{StaticResource TrajectoryItemSelector}"
                        ItemContainerStyle="{StaticResource EventListViewItemStyle}"
                        IsItemClickEnabled="True"
                        ItemClick="EventList_ItemClick"
                        Tapped="EventList_Tapped"
                        KeyDown="EventList_KeyDown"
                        SelectionChanged="EventList_SelectionChanged"
                        SelectionMode="Single" />
                    </SplitView.Content>
                    <SplitView.Pane>
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Padding="16,0,8,0">
                                <TextBlock Text="Event details" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="0">
                                    <Button
                                        Style="{StaticResource IconButtonStyle}"
                                        IsEnabled="{x:Bind ViewModel.HasSelectedEvent, Mode=OneWay}"
                                        Click="CopyEvent_Click"
                                        ToolTipService.ToolTip="Copy event"
                                        AutomationProperties.Name="Copy event">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                    </Button>
                                    <Button
                                        x:Name="CloseEventDetailButton"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="ToggleEventDetail_Click"
                                        ToolTipService.ToolTip="Close details"
                                        AutomationProperties.Name="Close details">
                                        <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <primitives:Thumb
                                x:Name="DetailResizeThumb"
                                Grid.RowSpan="2"
                                Canvas.ZIndex="2"
                                Width="8"
                                Margin="-4,0,0,0"
                                Style="{StaticResource DetailResizeThumbStyle}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                DragDelta="DetailResizeThumb_DragDelta"
                                AutomationProperties.Name="Resize event details" />
                            <ScrollViewer Grid.Row="1" Padding="16,4,16,20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.SelectedEvent.Detail.Title, Mode=OneWay, FallbackValue='Select an event'}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedEvent.Detail.Subtitle, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                <SelectorBar x:Name="DetailSelector" Margin="0,8,0,0" SelectionChanged="DetailSelector_SelectionChanged" />
                                <StackPanel>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedDetailSection.Fields, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:DetailFieldItem">
                                                <Grid MinHeight="26" Margin="0,1" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="108" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl
                                        ItemsSource="{x:Bind ViewModel.SelectedDetailSection.Blocks, Mode=OneWay}"
                                        ItemTemplateSelector="{StaticResource DetailBlockSelector}" />
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    </SplitView.Pane>
                </SplitView>

                <Grid
                    Grid.Row="2"
                    Grid.RowSpan="3"
                    Visibility="{x:Bind ViewModel.IsReviewMode, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Padding="0,4,0,12" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasReview, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Trace review" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.ReviewStatusLabel, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.ReviewCountSummary, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsReviewIdle, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ReviewProgressText, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsReviewBusy, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button
                                Content="Stop"
                                Visibility="{x:Bind ViewModel.IsReviewBusy, Mode=OneWay}"
                                Click="StopAnalysis_Click" />
                            <Button
                                Content="Analyze trace"
                                IsEnabled="{x:Bind ViewModel.CanAnalyze, Mode=OneWay}"
                                Click="AnalyzeTrace_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel
                            MaxWidth="560"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Visibility="{x:Bind ViewModel.HasNoReview, Mode=OneWay}">
                            <StackPanel HorizontalAlignment="Center" Spacing="10" Visibility="{x:Bind ViewModel.IsReviewIdle, Mode=OneWay}">
                                <TextBlock Text="Analyze this session with DotCraft" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                                <Button Content="Analyze trace" HorizontalAlignment="Center" IsEnabled="{x:Bind ViewModel.CanAnalyze, Mode=OneWay}" Click="AnalyzeTrace_Click" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" Spacing="10" Visibility="{x:Bind ViewModel.IsReviewBusy, Mode=OneWay}">
                                <ProgressRing Width="30" Height="30" HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.IsReviewBusy, Mode=OneWay}" />
                                <TextBlock Text="Analyzing trace" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.ReviewProgressText, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Content="Stop" HorizontalAlignment="Center" Click="StopAnalysis_Click" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.ReviewError, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>

                        <ScrollViewer Visibility="{x:Bind ViewModel.HasReview, Mode=OneWay}">
                            <StackPanel MaxWidth="920" HorizontalAlignment="Center" Padding="0,12,0,28" Spacing="18">
                            <StackPanel Spacing="18">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Summary" Style="{StaticResource SectionHeadingStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.ReviewSummary, Mode=OneWay}" FontSize="15" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.ReviewModel, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ReviewGeneratedAt, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.ReviewError, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.ReviewFindings, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:ReviewFindingItem">
                                            <Border Margin="0,0,0,10" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Grid VerticalAlignment="Center">
                                                            <Border Style="{StaticResource SeverityBadgeStyle}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{x:Bind IsMajor}">
                                                                <TextBlock Style="{StaticResource SeverityBadgeTextStyle}" Text="Major" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            </Border>
                                                            <Border Style="{StaticResource SeverityBadgeStyle}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{x:Bind IsMinor}">
                                                                <TextBlock Style="{StaticResource SeverityBadgeTextStyle}" Text="Minor" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                            </Border>
                                                            <Border Style="{StaticResource SeverityBadgeStyle}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" Visibility="{x:Bind IsSuggestion}">
                                                                <TextBlock Style="{StaticResource SeverityBadgeTextStyle}" Text="Suggestion" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Dimension}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Button Grid.Column="3" Content="Ask about this" VerticalAlignment="Center" Click="AttachFinding_Click" />
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Impact}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <StackPanel Spacing="3"><TextBlock Text="Recommendation" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Recommendation}" TextWrapping="Wrap" /></StackPanel>
                                                    <ItemsControl ItemsSource="{x:Bind Evidence}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:ReviewEvidenceItem">
                                                                <Button Margin="0,2" HorizontalAlignment="Left" Click="Evidence_Click">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{x:Bind Label}" /><TextBlock Text="{x:Bind RangeLabel}" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasReviewMessages, Mode=OneWay}">
                                    <TextBlock Text="Conversation" Style="{StaticResource SectionHeadingStyle}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.ReviewMessages, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:ReviewMessageItem">
                                                <StackPanel Margin="0,4,0,10" Spacing="3">
                                                    <TextBlock Text="{x:Bind Role}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                    <ItemsControl ItemsSource="{x:Bind Evidence}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:ReviewEvidenceItem"><Button HorizontalAlignment="Left" Click="Evidence_Click" Content="{x:Bind RangeLabel}" /></DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{x:Bind Timestamp}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Row="2" Padding="0,10,0,0" ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasReview, Mode=OneWay}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.ReviewAttachment, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBox PlaceholderText="Ask about this review or its evidence" Text="{x:Bind ViewModel.ReviewQuestion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Send" VerticalAlignment="Bottom" IsEnabled="{x:Bind ViewModel.CanAskReview, Mode=OneWay}" Click="AskReview_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </SplitView>
    </Grid>
</Window>
