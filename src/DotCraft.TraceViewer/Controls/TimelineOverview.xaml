<UserControl
    x:Class="DotCraft.TraceViewer.Controls.TimelineOverview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Padding="0,18,5,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="16" />
                <RowDefinition Height="16" />
                <RowDefinition Height="16" />
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Right" Text="Input" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Row="1" HorizontalAlignment="Right" Text="Model" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Row="2" HorizontalAlignment="Right" Text="Tools" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <ScrollViewer
            x:Name="TimelineScroll"
            Grid.Column="1"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            SizeChanged="TimelineScroll_SizeChanged">
            <Canvas
                x:Name="Plot"
                Height="80"
                PointerPressed="Plot_PointerPressed"
                PointerMoved="Plot_PointerMoved"
                PointerReleased="Plot_PointerReleased"
                PointerCanceled="Plot_PointerReleased" />
        </ScrollViewer>
    </Grid>
</UserControl>
