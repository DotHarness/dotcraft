<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DotCraft.Dashboard</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotCraft</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\DashBoardLogin.html" />
    <EmbeddedResource Include="Resources\dashboard\**\*" LogicalName="dashboard/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\desktop\src\renderer\styles\foundations\tokens.css" LogicalName="dashboard/assets/css/tokens.css" Link="Resources\dashboard\assets\css\tokens.css" />
    <EmbeddedResource Include="..\..\desktop\src\renderer\styles\foundations\themes.css" LogicalName="dashboard/assets/css/themes.css" Link="Resources\dashboard\assets\css\themes.css" />
    <EmbeddedResource Include="..\..\desktop\resources\dotcraft.svg" LogicalName="dashboard/assets/dotcraft.svg" Link="Resources\dashboard\assets\dotcraft.svg" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotCraft.Core\DotCraft.Core.csproj" />
    <ProjectReference Include="..\DotCraft.AppServer\DotCraft.AppServer.csproj" />
  </ItemGroup>

</Project>
