<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Publish a clean, single standalone executable named oratorio(.exe). -->
    <AssemblyName>oratorio</AssemblyName>
    <RootNamespace>DotCraft.Oratorio</RootNamespace>
    <ApplicationIcon>Resources\oratorio.ico</ApplicationIcon>
    <!-- Headless API: no static web assets, so skip the .staticwebassets.*.json manifest. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <PublishIISAssets>false</PublishIISAssets>
    <AssemblyVersion>0.6.3</AssemblyVersion>
    <Version>0.6.3</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <ProjectReference Include="..\..\sdk\dotnet\src\DotCraft.Sdk\DotCraft.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled MCP Apps served through standard resources/read from the single executable. -->
    <EmbeddedResource Include="UiResources\*.html"
                      LogicalName="DotCraft.Oratorio.UiResources.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotCraft.Oratorio.Tests" />
  </ItemGroup>

</Project>
