<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>dotcraft-satellite</AssemblyName>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\satellite.ico</ApplicationIcon>
    <AssemblyTitle>DotCraft Satellite</AssemblyTitle>
    <Product>DotCraft Satellite</Product>
    <Company>DotHarness</Company>
    <Copyright>Copyright © $([System.DateTime]::Now.Year) DotHarness</Copyright>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platforms>x64;arm64</Platforms>
    <!-- Velopack ships the published directory, so the launcher must stay a plain executable. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AssemblyVersion>0.14.1</AssemblyVersion>
    <Version>0.14.1</Version>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DefaultItemExcludes>$(DefaultItemExcludes);Pages\node_modules\**;Pages\dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" PrivateAssets="buildTransitive" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260528001" PrivateAssets="buildTransitive" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotCraft.RemoteTools\DotCraft.RemoteTools.csproj" GlobalPropertiesToRemove="Platform" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DotCraft.Satellite.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- WithCulture stops MSBuild reading "en" and "zh-Hans" as cultures and moving the catalogs
         into resource assemblies, which would leave the main assembly with no strings at all. -->
    <EmbeddedResource Include="Localization\Strings.en.json" WithCulture="false">
      <LogicalName>DotCraft.Satellite.Strings.en.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Localization\Strings.zh-Hans.json" WithCulture="false">
      <LogicalName>DotCraft.Satellite.Strings.zh-Hans.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Pages\dist\island.html">
      <LogicalName>DotCraft.Satellite.island.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Pages\dist\glow.html">
      <LogicalName>DotCraft.Satellite.glow.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Consent\consent.html">
      <LogicalName>DotCraft.Satellite.consent.html</LogicalName>
    </EmbeddedResource>
    <Content Include="Assets\satellite.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\tray-offline.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\tray-standby.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\tray-connected.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\tray-paused.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <SatellitePageInput Include="Pages\src\**\*;Pages\package.json;Pages\package-lock.json;Pages\vite.config.ts;Pages\tsconfig.json" />
    <SatellitePageInput Include="..\..\sdk\typescript\packages\island\src\**\*;..\..\sdk\typescript\packages\avatar\src\**\*" />
  </ItemGroup>

  <Target Name="RestoreSatellitePages" Condition="'$(DesignTimeBuild)' != 'true' And !Exists('Pages\node_modules\.package-lock.json')">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="Pages" />
  </Target>

  <Target Name="BuildSatellitePages" BeforeTargets="BeforeBuild" DependsOnTargets="RestoreSatellitePages" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(SatellitePageInput)" Outputs="Pages\dist\island.html;Pages\dist\glow.html">
    <Exec Command="npm run build" WorkingDirectory="Pages" />
  </Target>

</Project>
