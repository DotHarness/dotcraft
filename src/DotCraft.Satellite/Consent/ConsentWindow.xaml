<Window
    x:Class="DotCraft.Satellite.Consent.ConsentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid Background="{ThemeResource SatelliteSurfaceBrush}" Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource ConsentTitleStyle}" Text="{x:Bind ViewModel.Title}" />
            <TextBlock Style="{StaticResource ConsentSecondaryStyle}" Text="{x:Bind ViewModel.HubLine}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <StackPanel Spacing="8">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level3"
                        Style="{StaticResource ConsentHeadingStyle}"
                        Text="{x:Bind ViewModel.ModeHeading}" />

                    <Grid
                        AutomationProperties.AccessibilityView="Control"
                        AutomationProperties.Name="{x:Bind ViewModel.ModeHeading}"
                        ColumnSpacing="12"
                        XYFocusKeyboardNavigation="Enabled">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <RadioButton
                            Grid.Column="0"
                            AutomationProperties.Name="{x:Bind ViewModel.FullNarration}"
                            AutomationProperties.PositionInSet="1"
                            AutomationProperties.SizeOfSet="2"
                            Checked="FullAccessCardChecked"
                            GroupName="Mode"
                            IsChecked="{x:Bind ViewModel.FullAccess, Mode=OneWay}"
                            Style="{StaticResource ConsentModeCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource ConsentHeadingStyle}" Text="{x:Bind ViewModel.FullText}" />
                                <TextBlock Style="{StaticResource ConsentCaptionStyle}" Text="{x:Bind ViewModel.FullDescription}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton
                            Grid.Column="1"
                            AutomationProperties.Name="{x:Bind ViewModel.PreferredNarration}"
                            AutomationProperties.PositionInSet="2"
                            AutomationProperties.SizeOfSet="2"
                            Checked="WorkspaceCardChecked"
                            GroupName="Mode"
                            IsChecked="{x:Bind ViewModel.WorkspacePreferred, Mode=OneWay}"
                            Style="{StaticResource ConsentModeCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource ConsentHeadingStyle}" Text="{x:Bind ViewModel.PreferredText}" />
                                <TextBlock Style="{StaticResource ConsentCaptionStyle}" Text="{x:Bind ViewModel.PreferredDescription}" />
                                <StackPanel Margin="0,6,0,0" Spacing="2">
                                    <TextBlock Style="{StaticResource ConsentCaptionStyle}" Text="{x:Bind ViewModel.FolderHeading}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        MaxLines="2"
                                        Style="{StaticResource ConsentCaptionStyle}"
                                        Text="{x:Bind ViewModel.FolderPath, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.FolderPath, Mode=OneWay}" />
                                    <HyperlinkButton
                                        Command="{x:Bind ViewModel.ChangeFolderCommand}"
                                        Content="{x:Bind ViewModel.ChangeFolderText}"
                                        IsEnabled="{x:Bind ViewModel.CanPickFolder, Mode=OneWay}"
                                        MinHeight="0"
                                        MinWidth="0"
                                        Padding="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>

                <controls:InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Warning, Mode=OneWay}"
                    Severity="Warning" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="DeclineButton"
                MinWidth="104"
                Command="{x:Bind ViewModel.DeclineCommand}"
                Content="{x:Bind ViewModel.DeclineText}" />
            <Button
                MinWidth="104"
                Command="{x:Bind ViewModel.AllowCommand}"
                Content="{x:Bind ViewModel.AllowText}"
                IsEnabled="{x:Bind ViewModel.CanAllow, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
