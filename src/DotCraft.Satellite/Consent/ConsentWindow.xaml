<Window
    x:Class="DotCraft.Satellite.Consent.ConsentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid Background="{ThemeResource SatelliteSurfaceBrush}" Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource ConsentTitleStyle}" Text="{x:Bind ViewModel.Title}" />
            <TextBlock Style="{StaticResource ConsentSecondaryStyle}" Text="{x:Bind ViewModel.HubLine}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasPurpose}">
                    <TextBlock Style="{StaticResource ConsentHeadingStyle}" Text="{x:Bind ViewModel.PurposeHeading}" />
                    <Border
                        Background="{ThemeResource SatelliteQuoteBrush}"
                        CornerRadius="8"
                        Padding="12,10">
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource ConsentBodyStyle}"
                            Text="{x:Bind ViewModel.Purpose}" />
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource ConsentHeadingStyle}" Text="{x:Bind ViewModel.ModeHeading}" />
                    <RadioButton GroupName="Mode" IsChecked="{x:Bind ViewModel.WorkspacePreferred, Mode=OneWay}" Checked="PreferredChecked" Content="{x:Bind ViewModel.PreferredText}" />
                    <TextBlock Style="{StaticResource ConsentBodyStyle}" Text="{x:Bind ViewModel.PreferredDescription}" Visibility="{x:Bind ViewModel.WorkspacePreferred, Mode=OneWay}" />
                    <StackPanel Spacing="6" Margin="28,0,0,8" Visibility="{x:Bind ViewModel.WorkspacePreferred, Mode=OneWay}">
                        <TextBlock Style="{StaticResource ConsentHeadingStyle}" Text="{x:Bind ViewModel.FolderHeading}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.FolderPath, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                IsEnabled="{x:Bind ViewModel.CanChangeFolder}"
                                Command="{x:Bind ViewModel.ChangeFolderCommand}"
                                Content="{x:Bind ViewModel.ChangeFolderText}" />
                        </Grid>
                    </StackPanel>

                    <RadioButton GroupName="Mode" IsChecked="{x:Bind ViewModel.FullAccess, Mode=TwoWay}" Content="{x:Bind ViewModel.FullText}" />
                    <controls:InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.FullAccess, Mode=OneWay}"
                        Message="{x:Bind ViewModel.FullDescription}" Severity="Warning" />
                    <CheckBox Visibility="{x:Bind ViewModel.FullAccess, Mode=OneWay}" IsChecked="{x:Bind ViewModel.Acknowledged, Mode=TwoWay}">
                        <TextBlock TextWrapping="Wrap" Text="{x:Bind ViewModel.AcknowledgementText}" />
                    </CheckBox>
                </StackPanel>

                <controls:InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Warning, Mode=OneWay}"
                    Severity="Warning" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="DeclineButton"
                MinWidth="104"
                Command="{x:Bind ViewModel.DeclineCommand}"
                Content="{x:Bind ViewModel.DeclineText}" />
            <Button
                MinWidth="104"
                Command="{x:Bind ViewModel.AllowCommand}"
                Content="{x:Bind ViewModel.AllowText}"
                IsEnabled="{x:Bind ViewModel.CanAllow, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
