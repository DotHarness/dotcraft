<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotCraft</RootNamespace>

    <!-- Version Information -->
    <AssemblyVersion>0.15.0</AssemblyVersion>
    <Version>0.15.0</Version>
    <AssemblyName>dotcraft</AssemblyName>
    <AssemblyTitle>DotCraft</AssemblyTitle>
    <Product>DotCraft</Product>
    <ProductName>DotCraft</ProductName>
    <Company>DotHarness</Company>
    <Copyright>Copyright © $([System.DateTime]::Now.Year) DotHarness</Copyright>
    <ApplicationIcon>Resources\favicon.ico</ApplicationIcon>

    <!-- Keep the exact framework compilation references inside the self-contained bundle. -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Emit compiler generated files for debugging -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>

    <DotCraftGenerateModuleRegistrations>true</DotCraftGenerateModuleRegistrations>
    <DotCraftGenerateConfigSchemaRegistrations>true</DotCraftGenerateConfigSchemaRegistrations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\favicon.ico" LogicalName="DotCraft.Resources.favicon.ico" />
    <EmbeddedResource Include="Resources\Templates\**\*" />
    <EmbeddedResource Include="..\..\docker\dotcraft\docker-compose.yml" Link="Resources\Stack\docker-compose.yml" />
    <EmbeddedResource Include="..\..\docker\dotcraft\docker-compose.webhook.yml" Link="Resources\Stack\docker-compose.webhook.yml" />
    <EmbeddedResource Include="..\..\docker\dotcraft\Caddyfile" Link="Resources\Stack\Caddyfile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotHarness.Acp" Version="0.1.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
    <PackageReference Include="TextCopy" Version="6.2.1" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="ZLogger" Version="2.5.10" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotCraft.Core\DotCraft.Core.csproj" />
    <ProjectReference Include="..\..\sdk\dotnet\src\DotCraft.Sdk\DotCraft.Sdk.csproj" />
    <ProjectReference Include="..\DotCraft.Harness\DotCraft.Harness.csproj" />
    <ProjectReference Include="..\DotCraft.AppServer\DotCraft.AppServer.csproj" />
    <ProjectReference Include="..\DotCraft.Runtime\DotCraft.Runtime.csproj" />
    <ProjectReference Include="..\DotCraft.ContextExport\DotCraft.ContextExport.csproj" />
    <ProjectReference Include="..\DotCraft.Dashboard\DotCraft.Dashboard.csproj" />
    <ProjectReference Include="..\DotCraft.Oratorio\DotCraft.Oratorio.csproj" />
    <ProjectReference Include="..\DotCraft.CodexGateway\DotCraft.CodexGateway.csproj" />
    <ProjectReference Include="..\DotCraft.Agents.OpenAI\DotCraft.Agents.OpenAI.csproj" />
    <ProjectReference Include="..\DotCraft.Agents.Anthropic\DotCraft.Agents.Anthropic.csproj" />
    <ProjectReference Include="..\DotCraft.Agents.OpenRouter\DotCraft.Agents.OpenRouter.csproj" />
    <ProjectReference Include="..\DotCraft.Automations\DotCraft.Automations.csproj" />
    <ProjectReference Include="..\DotCraft.DynamicWorkflows\DotCraft.DynamicWorkflows.csproj" />
    <ProjectReference Include="..\DotCraft.CodeMode\DotCraft.CodeMode.csproj" />
    <ProjectReference Include="..\DotCraft.CSharp\DotCraft.CSharp.csproj" />
    <ProjectReference Include="..\DotCraft.SessionImport\DotCraft.SessionImport.csproj" />
    <ProjectReference Include="..\DotCraft.RemoteTools\DotCraft.RemoteTools.csproj" />
  </ItemGroup>

  <!-- Source Generator Reference -->
  <ItemGroup>
    <ProjectReference Include="..\DotCraft.Generators\DotCraft.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DotCraft.ModelService\DotCraft.ModelService.csproj" />
    <ProjectReference Include="..\DotCraft.Agents.Remote\DotCraft.Agents.Remote.csproj" />
  </ItemGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="DotCraftGenerateModuleRegistrations" />
    <CompilerVisibleProperty Include="DotCraftGenerateConfigSchemaRegistrations" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DotCraft.App.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="PruneUnusedPublishFiles"
          AfterTargets="ComputeResolvedFilesToPublishList"
          BeforeTargets="_ComputeFilesToBundle;PrepareForBundle"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <!-- CSharpReferenceSet requires Core and Agents XML docs. -->
      <_UnusedPublishFiles Include="@(ResolvedFileToPublish)"
                           Condition="'%(Extension)' == '.xml'
                                      and '%(Filename)' != 'DotCraft.Core'
                                      and '%(Filename)' != 'DotCraft.Agents'" />

      <!-- Matches CSharpReferenceSet.IsBclReference, excluding non-BCL PowerShell refs. -->
      <_UnusedPublishFiles Include="@(ResolvedFileToPublish)"
                           Condition="($([System.String]::Copy('%(RelativePath)').Replace('\', '/').StartsWith('refs/', System.StringComparison.OrdinalIgnoreCase)))
                                      and (
                                        (
                                          !$([System.String]::Copy('%(Filename)').StartsWith('System', System.StringComparison.OrdinalIgnoreCase))
                                          and !$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Win32', System.StringComparison.OrdinalIgnoreCase))
                                          and '%(Filename)' != 'Microsoft.CSharp'
                                          and !$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.VisualBasic', System.StringComparison.OrdinalIgnoreCase))
                                          and '%(Filename)' != 'netstandard'
                                          and '%(Filename)' != 'mscorlib'
                                        )
                                        or '%(Filename)' == 'System.Management.Automation'
                                        or '%(Filename)' == 'System.DirectoryServices'
                                        or '%(Filename)' == 'System.Management'
                                        or '%(Filename)' == 'System.Windows.Extensions'
                                      )" />

      <_UnusedPublishFiles Include="@(ResolvedFileToPublish)"
                           Condition="'%(Filename)%(Extension)' == 'aspnetcorev2_inprocess.dll'
                                      or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.AspNetCore.Components', System.StringComparison.OrdinalIgnoreCase))
                                      or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.AspNetCore.Mvc', System.StringComparison.OrdinalIgnoreCase))
                                      or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.AspNetCore.Razor', System.StringComparison.OrdinalIgnoreCase))
                                      or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.AspNetCore.Identity', System.StringComparison.OrdinalIgnoreCase))
                                      or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Extensions.Identity', System.StringComparison.OrdinalIgnoreCase))
                                      or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.AspNetCore.SignalR', System.StringComparison.OrdinalIgnoreCase))
                                      or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.AspNetCore.Http.Connections', System.StringComparison.OrdinalIgnoreCase))
                                      or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.AspNetCore.Localization', System.StringComparison.OrdinalIgnoreCase))
                                      or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.AspNetCore.ResponseCaching', System.StringComparison.OrdinalIgnoreCase))
                                      or '%(Filename)' == 'Microsoft.JSInterop'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.Antiforgery'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.Authentication.BearerToken'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.Authentication.Cookies'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.Authentication.OAuth'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.CookiePolicy'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.Cryptography.KeyDerivation'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.DataProtection.Extensions'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.Diagnostics.HealthChecks'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.Html.Abstractions'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.HttpLogging'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.HttpsPolicy'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.OutputCaching'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.RateLimiting'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.RequestDecompression'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.ResponseCompression'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.Rewrite'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.Session'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.StaticAssets'
                                      or '%(Filename)' == 'Microsoft.AspNetCore.StaticFiles'" />

      <ResolvedFileToPublish Remove="@(_UnusedPublishFiles)" />
    </ItemGroup>
  </Target>

</Project>
