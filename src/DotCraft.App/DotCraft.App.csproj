<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotCraft</RootNamespace>

    <!-- Version Information -->
    <AssemblyVersion>0.6.1</AssemblyVersion>
    <Version>0.6.1</Version>
    <AssemblyName>dotcraft</AssemblyName>
    <AssemblyTitle>DotCraft</AssemblyTitle>
    <ProductName>DotCraft</ProductName>
    <ApplicationIcon>Resources\favicon.ico</ApplicationIcon>

    <!-- Keep the exact framework compilation references inside the self-contained bundle. -->
    <PreserveCompilationContext>true</PreserveCompilationContext>

    <!-- Emit compiler generated files for debugging -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>

    <!-- Tells DotCraft.Generators to emit the ModuleRegistrations class in this assembly -->
    <DotCraftGenerateModuleRegistrations>true</DotCraftGenerateModuleRegistrations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources\favicon.ico" />
    <EmbeddedResource Include="Resources\Templates\**\*" />
    <EmbeddedResource Include="..\..\docker\dotcraft\docker-compose.yml" Link="Resources\Stack\docker-compose.yml" />
    <EmbeddedResource Include="..\..\docker\dotcraft\docker-compose.webhook.yml" Link="Resources\Stack\docker-compose.webhook.yml" />
    <EmbeddedResource Include="..\..\docker\dotcraft\Caddyfile" Link="Resources\Stack\Caddyfile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
    <PackageReference Include="TextCopy" Version="6.2.1" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="ZLogger" Version="2.5.10" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotCraft.Core\DotCraft.Core.csproj" />
    <ProjectReference Include="..\DotCraft.Harness\DotCraft.Harness.csproj" />
    <ProjectReference Include="..\DotCraft.AppServer\DotCraft.AppServer.csproj" />
    <ProjectReference Include="..\DotCraft.Runtime\DotCraft.Runtime.csproj" />
    <ProjectReference Include="..\DotCraft.ContextExport\DotCraft.ContextExport.csproj" />
    <ProjectReference Include="..\DotCraft.Dashboard\DotCraft.Dashboard.csproj" />
    <ProjectReference Include="..\DotCraft.Agents.OpenAI\DotCraft.Agents.OpenAI.csproj" />
    <ProjectReference Include="..\DotCraft.Agents.Anthropic\DotCraft.Agents.Anthropic.csproj" />
    <ProjectReference Include="..\DotCraft.Automations\DotCraft.Automations.csproj" />
    <ProjectReference Include="..\DotCraft.DynamicWorkflows\DotCraft.DynamicWorkflows.csproj" />
    <ProjectReference Include="..\DotCraft.OpenSandbox\DotCraft.OpenSandbox.csproj" />
    <ProjectReference Include="..\DotCraft.RemoteTools\DotCraft.RemoteTools.csproj" />
  </ItemGroup>

  <!-- Source Generator Reference -->
  <ItemGroup>
    <ProjectReference Include="..\DotCraft.Generators\DotCraft.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="DotCraftGenerateModuleRegistrations" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DotCraft.App.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
