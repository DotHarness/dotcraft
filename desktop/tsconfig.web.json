{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "paths": {
      "@renderer/*": ["./src/renderer/*"],
      "@/*": ["./src/renderer/*"]
    }
  },
  "include": [
    "src/bundled-plugins/**/*",
    "src/renderer/**/*",
    "src/preload/api.d.ts",
    "src/preload/index.ts",
    "src/preload/notificationDispatcher.ts",
    "src/shared/**/*"
  ],
  "exclude": ["node_modules", "src/**/tests/**", "src/**/*.test.*"]
}
