{
  "compilerOptions": {
    "composite": true,
    "outDir": "./node_modules/.cache/dotcraft/typescript/preload",
    "tsBuildInfoFile": "./node_modules/.cache/dotcraft/typescript/preload.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["electron-vite/node", "node"]
  },
  "include": ["src/preload/**/*", "src/shared/**/*"],
  "exclude": ["node_modules", "src/**/tests/**", "src/**/*.test.*"]
}
