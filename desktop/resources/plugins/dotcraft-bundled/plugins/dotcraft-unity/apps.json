{
  "apps": [
    {
      "appId": "com.dotharness.dotcraft-unity",
      "toolNamespace": "unity",
      "displayName": "Unity Editor",
      "developerName": "DotHarness",
      "description": "Invoke explicitly enabled Unity Editor runtime tools from selected DotCraft threads.",
      "category": "Engineering",
      "icon": "./assets/dotcraft-unity.svg",
      "releasePage": "https://github.com/DotHarness/dotcraft-unity",
      "nativeApplication": {
        "displayName": "Unity Editor",
        "installUrl": "https://unity.com/download"
      },
      "connection": {
        "handoffModes": [
          {
            "mode": "url",
            "uriTemplate": "http://127.0.0.1:39777/dotcraft/{operation}?app={appId}&request={requestId}&token={requestToken}&endpoint={endpoint}&scopes={scopes}"
          }
        ]
      },
      "scopes": [
        {
          "id": "unity.read",
          "displayName": "Read Unity project",
          "description": "Read scene hierarchy, selection, console logs, and project metadata.",
          "risk": "read",
          "defaultSelected": true
        },
        {
          "id": "unity.edit",
          "displayName": "Edit Unity project",
          "description": "Run enabled Unity tools that can mutate scene, asset, or project state.",
          "risk": "mutate"
        },
        {
          "id": "unity.execute",
          "displayName": "Execute Unity actions",
          "description": "Run enabled Unity tools that execute editor actions or plugin code.",
          "risk": "mutate"
        }
      ],
      "dynamicToolCatalog": {
        "enabled": true,
        "description": "The running Unity Editor attaches the currently enabled AgentToolAttribute runtime tools."
      },
      "toolCatalog": []
    }
  ]
}
