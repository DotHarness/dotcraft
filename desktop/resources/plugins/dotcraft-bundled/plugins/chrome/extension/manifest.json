{
  "manifest_version": 3,
  "name": "DotCraft",
  "version": "0.1.0",
  "description": "Connects DotCraft to your existing Chrome browser with explicit user control.",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/dotcraft-16.png",
    "32": "icons/dotcraft-32.png",
    "48": "icons/dotcraft-48.png",
    "128": "icons/dotcraft-128.png"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "DotCraft",
    "default_icon": {
      "16": "icons/dotcraft-16.png",
      "32": "icons/dotcraft-32.png",
      "48": "icons/dotcraft-48.png",
      "128": "icons/dotcraft-128.png"
    },
    "default_popup": "popup.html"
  }
}
