{
  "compilerOptions": {
    "composite": true,
    "outDir": "./node_modules/.cache/dotcraft/typescript/node",
    "tsBuildInfoFile": "./node_modules/.cache/dotcraft/typescript/node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["electron-vite/node", "node"]
  },
  "include": ["electron.vite.config.*", "package.json", "src/main/**/*", "src/main/**/*.json", "src/shared/**/*"],
  "exclude": ["node_modules", "src/**/tests/**", "src/**/*.test.*"]
}
