venv
tmp
*.tmp.md

# Channel modules staged for packaging, rebuilt from sdk/typescript/packages by
# build.bat. Dev resolves the SDK packages directly, so these exist only between a
# build and the electron-builder run. Their dist/ output was already ignored, which
# left the tracked manifests useless on their own and free to drift.
desktop/resources/modules/

# Local Playwright CLI state
desktop/.playwright-cli/
/sdk/typescript/packages/channel-weixin/data
/sdk/typescript/packages/channel-feishu/vendor

# Generated desktop web demo bundle (built from docs/demo)
docs/public/demo/

# Local Docker deployment state
/docker/.env
/docker/workspace/
