# Ignore cache and dist

.cursorignore
cache
dist

# TypeScript incremental build cache
*.tsbuildinfo

# Ignore Js dependencies

node_modules
.idea
.vs
bin
obj
build
out
*.user
.codebuddy
.vscode
.claude
.craft
.cursor/*
.ai
/references
