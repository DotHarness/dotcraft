        {
          "jsonrpc": "2.0",
          "id": 1,
          "result": {
            "serverInfo": { "name": "dotcraft", "version": "fixture", "protocolVersion": "1" },
            "capabilities": { "threadManagement": true, "threadSubscriptions": true }
          }
        },
        { "jsonrpc": "2.0", "method": "initialized", "params": {} }
